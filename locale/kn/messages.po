msgstr "%(query)s - ವಿಷಯ ಹುಡುಕಾಟ"

#: openlibrary/fastapi/search.py
msgid "Subject search"
msgstr "ವಿಷಯ ಹುಡುಕಾಟ"

#: openlibrary/fastapi/tasks.py
msgid "Someone else changed this project while you had it open. Check it below, then try again."
msgstr "ನೀವು ಇದನ್ನು ತೆರೆದಿರುವಾಗ ಬೇರೆಯವರು ಈ ಯೋಜನೆಯನ್ನು ಬದಲಾಯಿಸಿದ್ದಾರೆ. ಕೆಳಗೆ ಪರಿಶೀಲಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: openlibrary/fastapi/tasks.py
msgid "Tasks FAQ"
msgstr "ಟಾಸ್ಕ್‌ಗಳ FAQ"

#: openlibrary/fastapi/tasks.py
msgid "The project is set up. Check its books below."
msgstr "ಯೋಜನೆಯನ್ನು ಸ್ಥಾಪಿಸಲಾಗಿದೆ. ಕೆಳಗೆ ಅದರ ಪುಸ್ತಕಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

#: openlibrary/fastapi/tasks.py
msgid "The project is hidden from the Tasks and stats pages."
msgstr "ಯೋಜನೆಯನ್ನು ಟಾಸ್ಕ್‌ಗಳು ಮತ್ತು ಅಂಕಿಅಂಶಗಳ ಪುಟಗಳಿಂದ ಮರೆಮಾಡಲಾಗಿದೆ."

#: openlibrary/fastapi/tasks.py
msgid "The project is visible again."
msgstr "ಯೋಜನೆ ಮತ್ತೆ ಗೋಚರಿಸುತ್ತದೆ."

#: openlibrary/fastapi/tasks.py
msgid "Only a live project can be stopped."
msgstr "ಲೈವ್ ಯೋಜನೆಯನ್ನು ಮಾತ್ರ ನಿಲ್ಲಿಸಬಹುದು."

#: openlibrary/fastapi/tasks.py
msgid "The project has ended. It hands out no more tasks."
msgstr "ಯೋಜನೆ ಕೊನೆಗೊಂಡಿದೆ. ಇದು ಇನ್ನು ಯಾವುದೇ ಟಾಸ್ಕ್‌ಗಳನ್ನು ನೀಡುವುದಿಲ್ಲ."

#: openlibrary/fastapi/tasks.py
msgid "Only a live project that isn't hidden can be featured."
msgstr "ಮರೆಮಾಡದ ಲೈವ್ ಯೋಜನೆಯನ್ನು ಮಾತ್ರ ಫೀಚರ್ ಮಾಡಬಹುದು."

#: openlibrary/fastapi/tasks.py
msgid "This is now the featured project."
msgstr "ಇದು ಈಗ ಫೀಚರ್ಡ್ ಯೋಜನೆಯಾಗಿದೆ."

#: openlibrary/fastapi/tasks.py
msgid "A project needs books before it can start."
msgstr "ಪ್ರಾರಂಭವಾಗುವ ಮೊದಲು ಯೋಜನೆಗೆ ಪುಸ್ತಕಗಳು ಬೇಕು."

#: openlibrary/fastapi/tasks.py
msgid "Nothing changed."
msgstr "ಏನೂ ಬದಲಾಗಿಲ್ಲ."

#: openlibrary/fastapi/tasks.py
msgid "Saved."
msgstr "ಉಳಿಸಲಾಗಿದೆ."

#: openlibrary/fastapi/tasks.py
msgid "Only a project that hasn't started can be deleted. Stop or hide this one."
msgstr "ಇನ್ನೂ ಪ್ರಾರಂಭವಾಗದ ಯೋಜನೆಯನ್ನು ಮಾತ್ರ ಅಳಿಸಬಹುದು. ಇದನ್ನು ನಿಲ್ಲಿಸಿ ಅಥವಾ ಮರೆಮಾಡಿ."

#: openlibrary/fastapi/tasks.py
msgid "The project is deleted."
msgstr "ಯೋಜನೆಯನ್ನು ಅಳಿಸಲಾಗಿದೆ."

