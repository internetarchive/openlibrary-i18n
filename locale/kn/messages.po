msgstr "ಯೋಜನೆಗೆ ಶೀರ್ಷಿಕೆ ಬೇಕು."

#: openlibrary/contribute/manage.py
msgid "The title or description is too long."
msgstr "ಶೀರ್ಷಿಕೆ ಅಥವಾ ವಿವರಣೆ ತುಂಬಾ ಉದ್ದವಾಗಿದೆ."

#: openlibrary/contribute/manage.py
