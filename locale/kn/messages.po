msgstr "%(query)s - ಪಟ್ಟಿ ಹುಡುಕಾಟ"

#: openlibrary/fastapi/search.py
msgid "List search"
msgstr "ಪಟ್ಟಿ ಹುಡುಕಾಟ"

#: openlibrary/fastapi/search.py
