msgid "Finished %(date)s"
msgstr "%(date)s ರಂದು ಮುಗಿಸಲಾಗಿದೆ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Date removed"
msgstr "ದಿನಾಂಕ ತೆಗೆದುಹಾಕಲಾಗಿದೆ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Rate this book"
msgstr "ಈ ಪುಸ್ತಕವನ್ನು ರೇಟ್ ಮಾಡಿ"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "Rate %(rating)s of 5"
msgstr "5 ರಲ್ಲಿ %(rating)s ರೇಟ್ ಮಾಡಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Clear rating"
msgstr "ರೇಟಿಂಗ್ ತೆರವುಗೊಳಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Add to list"
msgstr "ಪಟ್ಟಿಗೆ ಸೇರಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "This edition has no work record yet, so it can be added to lists but not to your reading log."
msgstr "ಈ ಆವೃತ್ತಿಗೆ ಇನ್ನೂ ಕೃತಿ ದಾಖಲೆ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಇದನ್ನು ಪಟ್ಟಿಗಳಿಗೆ ಸೇರಿಸಬಹುದು ಆದರೆ ನಿಮ್ಮ ಓದುವ ದಾಖಲೆಗೆ ಅಲ್ಲ."

#: openlibrary/core/shell/shelf_labels.py
msgid "List name"
msgstr "ಪಟ್ಟಿ ಹೆಸರು"

#: openlibrary/core/shell/shelf_labels.py
msgid "Create"
msgstr "ರಚಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Filter lists…"
msgstr "ಪಟ್ಟಿಗಳನ್ನು ಫಿಲ್ಟರ್ ಮಾಡಿ…"

#: openlibrary/core/shell/shelf_labels.py
msgid "Create your first list"
msgstr "ನಿಮ್ಮ ಮೊದಲ ಪಟ್ಟಿಯನ್ನು ರಚಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "No lists match."
msgstr "ಯಾವುದೇ ಪಟ್ಟಿಗಳು ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ."

#: openlibrary/core/shell/shelf_labels.py
msgid "Loading lists…"
msgstr "ಪಟ್ಟಿಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ…"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "%(count)s item"
msgid_plural "%(count)s items"
msgstr[0] "%(count)s ಐಟಂ"
msgstr[1] "%(count)s ಐಟಂಗಳು"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "%(count)s other edition"
msgid_plural "%(count)s other editions"
msgstr[0] "%(count)s ಇತರ ಆವೃತ್ತಿ"
msgstr[1] "%(count)s ಇತರ ಆವೃತ್ತಿಗಳು"

#: openlibrary/core/shell/shelf_labels.py
msgid "Already on this list"
msgstr "ಈಗಾಗಲೇ ಈ ಪಟ್ಟಿಯಲ್ಲಿದೆ"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "On %(count)s list"
msgid_plural "On %(count)s lists"
msgstr[0] "%(count)s ಪಟ್ಟಿಯಲ್ಲಿ"
msgstr[1] "%(count)s ಪಟ್ಟಿಗಳಲ್ಲಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Recently used"
msgstr "ಇತ್ತೀಚೆಗೆ ಬಳಸಿದ"

#: openlibrary/core/shell/shelf_labels.py
msgid "On this book and recently used"
msgstr "ಈ ಪುಸ್ತಕದಲ್ಲಿ ಮತ್ತು ಇತ್ತೀಚೆಗೆ ಬಳಸಿದ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Other lists"
msgstr "ಇತರ ಪಟ್ಟಿಗಳು"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "Added to %(name)s"
msgstr "%(name)s ಗೆ ಸೇರಿಸಲಾಗಿದೆ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Manage lists"
msgstr "ಪಟ್ಟಿಗಳನ್ನು ನಿರ್ವಹಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Add date"
msgstr "ದಿನಾಂಕ ಸೇರಿಸಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "When did you finish this book?"
msgstr "ಈ ಪುಸ್ತಕವನ್ನು ನೀವು ಯಾವಾಗ ಮುಗಿಸಿದಿರಿ?"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "In %(year)s"
msgstr "%(year)s ರಲ್ಲಿ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Other date"
msgstr "ಬೇರೆ ದಿನಾಂಕ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Year"
msgstr "ವರ್ಷ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Remove date"
msgstr "ದಿನಾಂಕ ತೆಗೆದುಹಾಕಿ"

#: openlibrary/core/shell/shelf_labels.py
#, python-format
msgid "Moved to %(shelf)s"
msgstr "%(shelf)s ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ"

#: openlibrary/core/shell/shelf_labels.py
msgid "Undo"
msgstr "ರದ್ದುಗೊಳಿಸಿ"

#: openlibrary/core/tags.py
msgid "Novels, stories, plays and poems."
msgstr "ಕಾದಂಬರಿಗಳು, ಕಥೆಗಳು, ನಾಟಕಗಳು ಮತ್ತು ಕವಿತೆಗಳು."

#: openlibrary/core/tags.py
msgid "History, biography, memoir, essays, how-to and reference."
msgstr "ಇತಿಹಾಸ, ಜೀವನಚರಿತ್ರೆ, ಆತ್ಮಕಥೆ, ಪ್ರಬಂಧಗಳು, ಹೇಗೆ-ಮಾಡುವುದು ಮತ್ತು ಉಲ್ಲೇಖ."

#: openlibrary/core/tags.py
msgid "Hard to call, like a book based on a true story or a collection that mixes fiction and nonfiction."
msgstr "ನಿಜ ಕಥೆಯನ್ನು ಆಧರಿಸಿದ ಪುಸ್ತಕ ಅಥವಾ ಕಾಲ್ಪನಿಕ ಮತ್ತು ವಾಸ್ತವಿಕವನ್ನು ಬೆರೆಸುವ ಸಂಗ್ರಹದಂತೆ, ನಿರ್ಧರಿಸಲು ಕಷ್ಟ."

#: openlibrary/edition_scorecard.py
msgid "Can be accessed in full online (read / borrowed)"
msgstr "ಪೂರ್ಣವಾಗಿ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಪ್ರವೇಶಿಸಬಹುದು (ಓದಬಹುದು / ಎರವಲು ಪಡೆಯಬಹುದು)"

#: openlibrary/edition_scorecard.py
msgid "Borrowable and readable books can be accessed by readers, researchers, and all patrons alike."
msgstr "ಎರವಲು ಪಡೆಯಬಹುದಾದ ಮತ್ತು ಓದಬಹುದಾದ ಪುಸ್ತಕಗಳನ್ನು ಓದುಗರು, ಸಂಶೋಧಕರು ಮತ್ತು ಎಲ್ಲಾ ಬಳಕೆದಾರರು ಸಮಾನವಾಗಿ ಪ್ರವೇಶಿಸಬಹುದು."

#: openlibrary/edition_scorecard.py
msgid "Can view snippets via search inside"
msgstr "ಒಳಗೆ ಹುಡುಕಾಟದ ಮೂಲಕ ತುಣುಕುಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು"

#: openlibrary/edition_scorecard.py
msgid "Books that allow search inside enable patrons to quickly find relevant content within the book."
msgstr "ಒಳಗೆ ಹುಡುಕಾಟಕ್ಕೆ ಅನುಮತಿಸುವ ಪುಸ್ತಕಗಳು ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕದೊಳಗಿನ ಸಂಬಂಧಿತ ವಿಷಯವನ್ನು ತ್ವರಿತವಾಗಿ ಕಂಡುಹಿಡಿಯಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Open access (can analyze in full)"
msgstr "ಮುಕ್ತ ಪ್ರವೇಶ (ಪೂರ್ಣವಾಗಿ ವಿಶ್ಲೇಷಿಸಬಹುದು)"

#: openlibrary/edition_scorecard.py
msgid "Fully public books can be read online or downloaded without any restrictions, providing excellent access for patrons."
msgstr "ಸಂಪೂರ್ಣವಾಗಿ ಸಾರ್ವಜನಿಕ ಪುಸ್ತಕಗಳನ್ನು ಯಾವುದೇ ನಿರ್ಬಂಧಗಳಿಲ್ಲದೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಓದಬಹುದು ಅಥವಾ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬಹುದು, ಬಳಕೆದಾರರಿಗೆ ಅತ್ಯುತ್ತಮ ಪ್ರವೇಶವನ್ನು ಒದಗಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has purchase options"
msgstr "ಖರೀದಿ ಆಯ್ಕೆಗಳನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "An ISBN, Amazon ASIN identifier, or BWB identifier enables patrons to purchase the book from retailers."
msgstr "ISBN, Amazon ASIN ಗುರುತಿಸುವಿಕೆ, ಅಥವಾ BWB ಗುರುತಿಸುವಿಕೆ ಬಳಕೆದಾರರಿಗೆ ಚಿಲ್ಲರೆ ವ್ಯಾಪಾರಿಗಳಿಂದ ಪುಸ್ತಕವನ್ನು ಖರೀದಿಸಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has library options (ISBN or OCLC)"
msgstr "ಗ್ರಂಥಾಲಯ ಆಯ್ಕೆಗಳನ್ನು ಹೊಂದಿದೆ (ISBN ಅಥವಾ OCLC)"

#: openlibrary/edition_scorecard.py
msgid "ISBN or OCLC numbers enable patrons to find the book through library catalogs."
msgstr "ISBN ಅಥವಾ OCLC ಸಂಖ್ಯೆಗಳು ಬಳಕೆದಾರರಿಗೆ ಗ್ರಂಥಾಲಯ ಕ್ಯಾಟಲಾಗ್‌ಗಳ ಮೂಲಕ ಪುಸ್ತಕವನ್ನು ಕಂಡುಹಿಡಿಯಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has fan fiction link (Archive of Our Own)"
msgstr "ಫ್ಯಾನ್ ಫಿಕ್ಷನ್ ಲಿಂಕ್ ಹೊಂದಿದೆ (Archive of Our Own)"

#: openlibrary/edition_scorecard.py
msgid "A link to Archive of Our Own helps readers discover related fan-created works."
msgstr "Archive of Our Own ಗೆ ಲಿಂಕ್ ಓದುಗರಿಗೆ ಸಂಬಂಧಿತ ಅಭಿಮಾನಿಗಳು-ರಚಿಸಿದ ಕೃತಿಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has Wikipedia link"
msgstr "Wikipedia ಲಿಂಕ್ ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "A Wikipedia link provides additional context and encyclopedic information about the work."
msgstr "Wikipedia ಲಿಂಕ್ ಕೃತಿಯ ಬಗ್ಗೆ ಹೆಚ್ಚುವರಿ ಸಂದರ್ಭ ಮತ್ತು ವಿಶ್ವಕೋಶ ಮಾಹಿತಿಯನ್ನು ಒದಗಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has first sentence"
msgstr "ಮೊದಲ ವಾಕ್ಯವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "The first sentence gives patrons an immediate taste of the writing style."
msgstr "ಮೊದಲ ವಾಕ್ಯ ಬಳಕೆದಾರರಿಗೆ ಬರವಣಿಗೆಯ ಶೈಲಿಯ ತಕ್ಷಣದ ರುಚಿಯನ್ನು ನೀಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has title field"
msgstr "ಶೀರ್ಷಿಕೆ ಕ್ಷೇತ್ರವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "A title is essential for discovery and helps patrons identify the book in search results and catalogs."
msgstr "ಅನ್ವೇಷಣೆಗೆ ಶೀರ್ಷಿಕೆ ಅತ್ಯಗತ್ಯ ಮತ್ತು ಹುಡುಕಾಟ ಫಲಿತಾಂಶಗಳು ಮತ್ತು ಕ್ಯಾಟಲಾಗ್‌ಗಳಲ್ಲಿ ಪುಸ್ತಕವನ್ನು ಗುರುತಿಸಲು ಬಳಕೆದಾರರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has author information"
msgstr "ಲೇಖಕ ಮಾಹಿತಿಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Author information is crucial for discovery and helps patrons find other works by the same author."
msgstr "ಲೇಖಕ ಮಾಹಿತಿ ಅನ್ವೇಷಣೆಗೆ ನಿರ್ಣಾಯಕವಾಗಿದೆ ಮತ್ತು ಅದೇ ಲೇಖಕರ ಇತರ ಕೃತಿಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಬಳಕೆದಾರರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has genre/category tags"
msgstr "ಪ್ರಕಾರ/ವರ್ಗ ಟ್ಯಾಗ್‌ಗಳನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons search by genre or category to discover relevant books."
msgstr "ಪ್ರಕಾರ ಟ್ಯಾಗ್‌ಗಳು ಬಳಕೆದಾರರಿಗೆ ಸಂಬಂಧಿತ ಪುಸ್ತಕಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಪ್ರಕಾರ ಅಥವಾ ವರ್ಗದ ಮೂಲಕ ಹುಡುಕಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has series information"
msgstr "ಸರಣಿ ಮಾಹಿತಿಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons search by series and discover related books."
msgstr "ಸರಣಿ ಮಾಹಿತಿ ಬಳಕೆದಾರರಿಗೆ ಸರಣಿಯ ಮೂಲಕ ಹುಡುಕಲು ಮತ್ತು ಸಂಬಂಧಿತ ಪುಸ್ತಕಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has table of contents"
msgstr "ವಿಷಯ ಸೂಚಿಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Table of contents entries are indexed and searchable, improving discoverability."
msgstr "ವಿಷಯ ಸೂಚಿ ನಮೂದುಗಳನ್ನು ಸೂಚ್ಯಂಕಗೊಳಿಸಲಾಗಿದೆ ಮತ್ತು ಹುಡುಕಬಹುದಾಗಿದೆ, ಅನ್ವೇಷಣೀಯತೆಯನ್ನು ಸುಧಾರಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has DDC or LCC classification"
msgstr "DDC ಅಥವಾ LCC ವರ್ಗೀಕರಣವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Dewey Decimal or Library of Congress classifications help with organization and shelf browsing."
msgstr "Dewey Decimal ಅಥವಾ Library of Congress ವರ್ಗೀಕರಣಗಳು ಸಂಘಟನೆ ಮತ್ತು ಕಪಾಟು ಬ್ರೌಸಿಂಗ್‌ಗೆ ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has language information"
msgstr "ಭಾಷಾ ಮಾಹಿತಿಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Language information helps patrons filter and find books in their preferred language."
msgstr "ಭಾಷಾ ಮಾಹಿತಿ ಬಳಕೆದಾರರಿಗೆ ಅವರ ಆದ್ಯತೆಯ ಭಾಷೆಯಲ್ಲಿ ಪುಸ್ತಕಗಳನ್ನು ಫಿಲ್ಟರ್ ಮಾಡಲು ಮತ್ತು ಕಂಡುಹಿಡಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has ISBN"
msgstr "ISBN ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "ISBNs allow searching by barcode scanner and help with identification."
msgstr "ISBN ಗಳು ಬಾರ್‌ಕೋಡ್ ಸ್ಕ್ಯಾನರ್ ಮೂಲಕ ಹುಡುಕಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತವೆ ಮತ್ತು ಗುರುತಿಸುವಿಕೆಗೆ ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has Lexile measure"
msgstr "Lexile ಅಳತೆಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Lexile measures help educators and parents find books at the appropriate reading level."
msgstr "Lexile ಅಳತೆಗಳು ಶಿಕ್ಷಕರು ಮತ್ತು ಪೋಷಕರಿಗೆ ಸೂಕ್ತ ಓದುವ ಮಟ್ಟದಲ್ಲಿ ಪುಸ್ತಕಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (ranking signal)"
msgstr "ಸ್ಟಾರ್ ರೇಟಿಂಗ್‌ಗಳನ್ನು ಹೊಂದಿದೆ (ಶ್ರೇಣಿ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings contribute to search ranking so better-rated books surface higher."
msgstr "ಸ್ಟಾರ್ ರೇಟಿಂಗ್‌ಗಳು ಹುಡುಕಾಟ ಶ್ರೇಣಿಗೆ ಕೊಡುಗೆ ನೀಡುತ್ತವೆ, ಆದ್ದರಿಂದ ಉತ್ತಮ-ರೇಟ್ ಮಾಡಿದ ಪುಸ್ತಕಗಳು ಮೇಲ್ಭಾಗದಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Appears on reading logs (ranking signal)"
msgstr "ಓದುವ ದಾಖಲೆಗಳಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ (ಶ್ರೇಣಿ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Presence on reading logs is a popularity signal that helps with search ranking."
msgstr "ಓದುವ ದಾಖಲೆಗಳಲ್ಲಿ ಇರುವಿಕೆ ಹುಡುಕಾಟ ಶ್ರೇಣಿಗೆ ಸಹಾಯ ಮಾಡುವ ಜನಪ್ರಿಯತೆಯ ಸಂಕೇತವಾಗಿದೆ."

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (ranking signal)"
msgstr "ಪಟ್ಟಿಗಳಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ (ಶ್ರೇಣಿ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Presence on user lists is a popularity signal that helps with search ranking."
msgstr "ಬಳಕೆದಾರ ಪಟ್ಟಿಗಳಲ್ಲಿ ಇರುವಿಕೆ ಹುಡುಕಾಟ ಶ್ರೇಣಿಗೆ ಸಹಾಯ ಮಾಡುವ ಜನಪ್ರಿಯತೆಯ ಸಂಕೇತವಾಗಿದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has contributor names"
msgstr "ಕೊಡುಗೆದಾರರ ಹೆಸರುಗಳನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Contributor names (editors, illustrators, translators) enable searching by contributor."
msgstr "ಕೊಡುಗೆದಾರರ ಹೆಸರುಗಳು (ಸಂಪಾದಕರು, ಚಿತ್ರಕಾರರು, ಅನುವಾದಕರು) ಕೊಡುಗೆದಾರರ ಮೂಲಕ ಹುಡುಕಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has a description"
msgstr "ವಿವರಣೆಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "A description helps patrons understand what the book is about before accessing it."
msgstr "ವಿವರಣೆ ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕವನ್ನು ಪ್ರವೇಶಿಸುವ ಮೊದಲು ಅದು ಏನರ ಬಗ್ಗೆ ಎಂದು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has cover image"
msgstr "ಮುಖಪುಟ ಚಿತ್ರವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "A cover image helps patrons visually identify the book and makes it more appealing in search results."
msgstr "ಮುಖಪುಟ ಚಿತ್ರ ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕವನ್ನು ದೃಷ್ಟಿಗೋಚರವಾಗಿ ಗುರುತಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ ಮತ್ತು ಹುಡುಕಾಟ ಫಲಿತಾಂಶಗಳಲ್ಲಿ ಹೆಚ್ಚು ಆಕರ್ಷಕವಾಗಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "A table of contents helps patrons evaluate the structure and scope of the book."
msgstr "ವಿಷಯ ಸೂಚಿ ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕದ ರಚನೆ ಮತ್ತು ವ್ಯಾಪ್ತಿಯನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons quickly assess whether a book matches their interests."
msgstr "ಪ್ರಕಾರ ಟ್ಯಾಗ್‌ಗಳು ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕ ಅವರ ಆಸಕ್ತಿಗಳಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತದೆಯೇ ಎಂದು ತ್ವರಿತವಾಗಿ ನಿರ್ಣಯಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (popularity signal)"
msgstr "ಸ್ಟಾರ್ ರೇಟಿಂಗ್‌ಗಳನ್ನು ಹೊಂದಿದೆ (ಜನಪ್ರಿಯತೆ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings from other readers help patrons gauge the quality and reception of the book."
msgstr "ಇತರ ಓದುಗರಿಂದ ಸ್ಟಾರ್ ರೇಟಿಂಗ್‌ಗಳು ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕದ ಗುಣಮಟ್ಟ ಮತ್ತು ಸ್ವೀಕಾರವನ್ನು ಅಳೆಯಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Has a rich description (50+ characters)"
msgstr "ಶ್ರೀಮಂತ ವಿವರಣೆಯನ್ನು ಹೊಂದಿದೆ (50+ ಅಕ್ಷರಗಳು)"

#: openlibrary/edition_scorecard.py
msgid "A detailed description (50+ characters) provides more context to help patrons evaluate relevance."
msgstr "ವಿವರವಾದ ವಿವರಣೆ (50+ ಅಕ್ಷರಗಳು) ಬಳಕೆದಾರರಿಗೆ ಸಂಬಂಧವನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಸಹಾಯ ಮಾಡಲು ಹೆಚ್ಚಿನ ಸಂದರ್ಭವನ್ನು ಒದಗಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has reading log activity (popularity signal)"
msgstr "ಓದುವ ದಾಖಲೆ ಚಟುವಟಿಕೆಯನ್ನು ಹೊಂದಿದೆ (ಜನಪ್ರಿಯತೆ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Reading log activity from other patrons signals the book is being actively read."
msgstr "ಇತರ ಬಳಕೆದಾರರ ಓದುವ ದಾಖಲೆ ಚಟುವಟಿಕೆ ಪುಸ್ತಕವನ್ನು ಸಕ್ರಿಯವಾಗಿ ಓದಲಾಗುತ್ತಿದೆ ಎಂದು ಸೂಚಿಸುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (popularity signal)"
msgstr "ಪಟ್ಟಿಗಳಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ (ಜನಪ್ರಿಯತೆ ಸಂಕೇತ)"

#: openlibrary/edition_scorecard.py
msgid "Presence on curated lists helps patrons gauge relevance and community interest."
msgstr "ಸಂಗ್ರಹಿಸಿದ ಪಟ್ಟಿಗಳಲ್ಲಿ ಇರುವಿಕೆ ಬಳಕೆದಾರರಿಗೆ ಸಂಬಂಧ ಮತ್ತು ಸಮುದಾಯದ ಆಸಕ್ತಿಯನ್ನು ಅಳೆಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has page count"
msgstr "ಪುಟಗಳ ಸಂಖ್ಯೆಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Page count helps patrons estimate the length and time commitment of the book."
msgstr "ಪುಟಗಳ ಸಂಖ್ಯೆ ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕದ ಉದ್ದ ಮತ್ತು ಸಮಯದ ಬದ್ಧತೆಯನ್ನು ಅಂದಾಜಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons understand the book's place in a broader narrative."
msgstr "ಸರಣಿ ಮಾಹಿತಿ ಬಳಕೆದಾರರಿಗೆ ವಿಶಾಲ ನಿರೂಪಣೆಯಲ್ಲಿ ಪುಸ್ತಕದ ಸ್ಥಾನವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has author photo"
msgstr "ಲೇಖಕ ಫೋಟೋವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "An author photo helps patrons visually recognize the author."
msgstr "ಲೇಖಕ ಫೋಟೋ ಬಳಕೆದಾರರಿಗೆ ಲೇಖಕರನ್ನು ದೃಷ್ಟಿಗೋಚರವಾಗಿ ಗುರುತಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has first publication year"
msgstr "ಮೊದಲ ಪ್ರಕಟಣಾ ವರ್ಷವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "The first publication year helps patrons understand when the work originally appeared."
msgstr "ಮೊದಲ ಪ್ರಕಟಣಾ ವರ್ಷ ಬಳಕೆದಾರರಿಗೆ ಕೃತಿ ಮೂಲತಃ ಯಾವಾಗ ಕಾಣಿಸಿಕೊಂಡಿತು ಎಂದು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
msgid "Has publication year"
msgstr "ಪ್ರಕಟಣಾ ವರ್ಷವನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Publication year helps patrons understand the context and currency of the content."
msgstr "ಪ್ರಕಟಣಾ ವರ್ಷ ಬಳಕೆದಾರರಿಗೆ ವಿಷಯದ ಸಂದರ್ಭ ಮತ್ತು ಪ್ರಸ್ತುತತೆಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has author biography"
msgstr "ಲೇಖಕ ಜೀವನಚರಿತ್ರೆಯನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "An author biography helps patrons understand the author's background and expertise."
msgstr "ಲೇಖಕ ಜೀವನಚರಿತ್ರೆ ಬಳಕೆದಾರರಿಗೆ ಲೇಖಕರ ಹಿನ್ನೆಲೆ ಮತ್ತು ಪರಿಣತಿಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
msgid "Has publisher"
msgstr "ಪ್ರಕಾಶಕರನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Publisher information helps patrons evaluate the credibility and source of the book."
msgstr "ಪ್ರಕಾಶಕ ಮಾಹಿತಿ ಬಳಕೆದಾರರಿಗೆ ಪುಸ್ತಕದ ವಿಶ್ವಾಸಾರ್ಹತೆ ಮತ್ತು ಮೂಲವನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: openlibrary/edition_scorecard.py
msgid "Has author links"
msgstr "ಲೇಖಕ ಲಿಂಕ್‌ಗಳನ್ನು ಹೊಂದಿದೆ"

#: openlibrary/edition_scorecard.py
msgid "Links to author websites or profiles provide additional context about the author."
msgstr "ಲೇಖಕರ ವೆಬ್‌ಸೈಟ್‌ಗಳು ಅಥವಾ ಪ್ರೊಫೈಲ್‌ಗಳಿಗೆ ಲಿಂಕ್‌ಗಳು ಲೇಖಕರ ಬಗ್ಗೆ ಹೆಚ್ಚುವರಿ ಸಂದರ್ಭವನ್ನು ಒದಗಿಸುತ್ತವೆ."

#: openlibrary/edition_scorecard.py
msgid "Edition Scorecard"
msgstr "ಆವೃತ್ತಿ ಸ್ಕೋರ್‌ಕಾರ್ಡ್"

#: openlibrary/edition_scorecard.py
msgid "Discovery"
msgstr "ಅನ್ವೇಷಣೆ"

#: openlibrary/edition_scorecard.py
msgid "How well can this edition be accurately surfaced in searches and recommendations?"
msgstr "ಈ ಆವೃತ್ತಿಯನ್ನು ಹುಡುಕಾಟಗಳು ಮತ್ತು ಶಿಫಾರಸುಗಳಲ್ಲಿ ಎಷ್ಟು ಸರಿಯಾಗಿ ಕಾಣಿಸಬಹುದು?"

#: openlibrary/edition_scorecard.py
msgid "Evaluation"
msgstr "ಮೌಲ್ಯಮಾಪನ"

#: openlibrary/edition_scorecard.py
msgid "How well can a patron determine if this edition is relevant to their needs before accessing it?"
msgstr "ಬಳಕೆದಾರರು ಪ್ರವೇಶಿಸುವ ಮೊದಲು ಈ ಆವೃತ್ತಿ ಅವರ ಅಗತ್ಯಗಳಿಗೆ ಸಂಬಂಧಿತವಾಗಿದೆಯೇ ಎಂದು ಎಷ್ಟು ಚೆನ್ನಾಗಿ ನಿರ್ಧರಿಸಬಹುದು?"

