#: openlibrary/contribute/field_guides.py
msgid "WorldCat"
msgstr "WorldCat"

#: openlibrary/contribute/field_guides.py
msgid "Google Books"
msgstr "Google Books"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/partials.py
msgid "Amazon"
msgstr "Amazon"

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress"
msgstr "Biblioteca del Congrés"

#: openlibrary/contribute/field_guides.py
msgid "Fill in language"
msgstr "Omple l'idioma"

#: openlibrary/contribute/field_guides.py
msgid "Look the ISBN up in WorldCat or Google Books; both list the language of the text. The title page and cover tell you too."
msgstr "Cerca l'ISBN a WorldCat o Google Books; tots dos indiquen l'idioma del text. La portadella i la coberta també t'ho diuen."

#: openlibrary/contribute/field_guides.py
msgid "Editions of a work usually share a language, but a translation won't. Check this edition's own text."
msgstr "Les edicions d'una obra normalment comparteixen un idioma, però una traducció no. Comprova el text d'aquesta edició."

#: openlibrary/contribute/field_guides.py
msgid "Record the language of the text, not the language of the title page. A translation is in the language it was translated into."
msgstr "Anota l'idioma del text, no l'idioma de la portadella. Una traducció està en l'idioma al qual s'ha traduït."

#: openlibrary/contribute/field_guides.py
msgid "For example English"
msgstr "Per exemple anglès"

#: openlibrary/contribute/field_guides.py
msgid "Page count"
msgstr "Nombre de pàgines"

#: openlibrary/contribute/field_guides.py
msgid "Fill in page count"
msgstr "Omple el nombre de pàgines"

#: openlibrary/contribute/field_guides.py
msgid "How many pages does this edition have?"
msgstr "Quantes pàgines té aquesta edició?"

#: openlibrary/contribute/field_guides.py
msgid "WorldCat lists the page count in the record's description. Google Books calls it Length. Make sure the record is for this ISBN, not another printing."
msgstr "WorldCat indica el nombre de pàgines a la descripció del registre. Google Books ho anomena Longitud. Assegura't que el registre és per a aquest ISBN, no per a una altra impressió."

#: openlibrary/contribute/field_guides.py
msgid "Catalogs count front matter differently, so numbers within a few pages of each other are the same count. Use the last numbered page of the main text."
msgstr "Els catàlegs compten les pàgines preliminars de manera diferent, així que números que difereixen poques pàgines es consideren el mateix recompte. Utilitza l'última pàgina numerada del text principal."

#: openlibrary/contribute/field_guides.py
msgid "For example 320"
msgstr "Per exemple 320"

#: openlibrary/contribute/field_guides.py
msgid "Fill in publisher"
msgstr "Omple l'editorial"

#: openlibrary/contribute/field_guides.py
msgid "Who published this edition?"
msgstr "Qui va publicar aquesta edició?"

#: openlibrary/contribute/field_guides.py
msgid "The imprint is printed on the title page and the spine. WorldCat and the Library of Congress list it under Publisher."
msgstr "El segell editorial està imprès a la portadella i al llom. WorldCat i la Biblioteca del Congrés el llisten com a Editorial."

#: openlibrary/contribute/field_guides.py
msgid "Open Library records the imprint printed on the book, not the parent company. Anchor Books, not Penguin Random House."
msgstr "Open Library anota el segell editorial imprès al llibre, no l'empresa matriu. Anchor Books, no Penguin Random House."

#: openlibrary/contribute/field_guides.py
msgid "Publisher as printed"
msgstr "Editorial tal com apareix impresa"

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress number (LCCN)"
msgstr "Número de la Biblioteca del Congrés (LCCN)"

#: openlibrary/contribute/field_guides.py
msgid "Fill in LCCN"
msgstr "Omple l'LCCN"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's Library of Congress number?"
msgstr "Quin és el número de la Biblioteca del Congrés d'aquesta edició?"

#: openlibrary/contribute/field_guides.py
msgid "Search the Library of Congress catalog for this ISBN. Open the record whose year and publisher match this edition, and copy the number shown as LCCN."
msgstr "Cerca aquest ISBN al catàleg de la Biblioteca del Congrés. Obre el registre l'any i l'editorial del qual coincideixin amb aquesta edició, i copia el número que es mostra com a LCCN."

#: openlibrary/contribute/field_guides.py
msgid "Hyphenated and padded forms are the same number: 75-425165 and 75425165. Paste either; Open Library stores the padded form."
msgstr "Les formes amb guionet i amb farciment són el mateix número: 75-425165 i 75425165. Enganxa'n qualsevol; Open Library emmagatzema la forma amb farciment."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different printing. Search results lead with the best-known one, not with yours."
msgstr "El número pertany a una impressió diferent. Els resultats de cerca mostren primer la més coneguda, no la teva."

#: openlibrary/contribute/field_guides.py
msgid "The number is already on another edition of this work, which means one of the two records is wrong."
msgstr "El número ja és en una altra edició d'aquesta obra, cosa que significa que un dels dos registres és incorrecte."

#: openlibrary/contribute/field_guides.py
msgid "Pasting the web address instead of the number itself."
msgstr "Enganxar l'adreça web en lloc del número mateix."

#: openlibrary/contribute/field_guides.py
msgid "For example 75425165"
msgstr "Per exemple 75425165"

#: openlibrary/contribute/field_guides.py
msgid "OCLC/WorldCat number"
msgstr "Número OCLC/WorldCat"

#: openlibrary/contribute/field_guides.py
msgid "Fill in OCLC number"
msgstr "Omple el número OCLC"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's WorldCat (OCLC) number?"
msgstr "Quin és el número WorldCat (OCLC) d'aquesta edició?"

#: openlibrary/contribute/field_guides.py
msgid "Search WorldCat for this ISBN. Open the record whose year, publisher and format match this edition, and copy the number shown as OCLC Number."
msgstr "Cerca aquest ISBN a WorldCat. Obre el registre l'any, l'editorial i el format del qual coincideixin amb aquesta edició, i copia el número que es mostra com a OCLC Number."

#: openlibrary/contribute/field_guides.py
msgid "The OCLC number is how libraries the world over refer to one catalogued edition. It is one of the few fields Open Library uses to find duplicates of this book when new records arrive."
msgstr "El número OCLC és com les biblioteques d'arreu del món es refereixen a una edició catalogada. És un dels pocs camps que Open Library utilitza per trobar duplicats d'aquest llibre quan arriben registres nous."

#: openlibrary/contribute/field_guides.py
msgid "The prefixes ocm, ocn, on and (OCoLC) are padding added by library systems, not part of the number. ocm00047810608 is 47810608."
msgstr "Els prefixos ocm, ocn, on i (OCoLC) són farciment afegit pels sistemes de biblioteca, no formen part del número. ocm00047810608 és 47810608."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different printing, a book club edition, or the ebook rather than the print copy."
msgstr "El número pertany a una impressió diferent, a una edició de club del llibre, o al llibre electrònic en lloc de la còpia impresa."

#: openlibrary/contribute/field_guides.py
msgid "Pasting the web address, or leaving the ocm/ocn prefix on."
msgstr "Enganxar l'adreça web, o deixar el prefix ocm/ocn."

#: openlibrary/contribute/field_guides.py
msgid "Digits only, for example 47810608"
msgstr "Només dígits, per exemple 47810608"

#: openlibrary/contribute/save.py
msgid "Pick a language from the list."
msgstr "Tria un idioma de la llista."

#: openlibrary/contribute/save.py
msgid "Enter the page count as a whole number."
msgstr "Introdueix el nombre de pàgines com a número enter."

#: openlibrary/contribute/save.py
msgid "Fill in an answer, or choose “I couldn't find it”."
msgstr "Omple una resposta, o tria «No ho he trobat»."

#: openlibrary/contribute/save.py
msgid "This field can't be filled in here."
msgstr "Aquest camp no es pot omplir aquí."

#: openlibrary/contribute/save.py
#, python-format
msgid "Filled in %(field)s from Open Library Tasks"
msgstr "S'ha omplert %(field)s des de les tasques d'Open Library"

