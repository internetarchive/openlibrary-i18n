msgid "Access"
msgstr "Accés"

#: openlibrary/edition_scorecard.py
msgid "Discovery"
msgstr "Descobriment"

#: openlibrary/edition_scorecard.py
msgid "How well can this edition be accurately surfaced in searches and recommendations?"
msgstr "Amb quina precisió es pot mostrar aquesta edició en cerques i recomanacions?"

#: openlibrary/edition_scorecard.py
msgid "Evaluation"
msgstr "Avaluació"

#: openlibrary/edition_scorecard.py
msgid "How well can a patron determine if this edition is relevant to their needs before accessing it?"
msgstr "Amb quina facilitat pot un usuari determinar si aquesta edició és rellevant per a les seves necessitats abans d'accedir-hi?"

