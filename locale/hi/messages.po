msgstr "%(time)s UTC"

#: openlibrary/contribute/manage.py
msgid "The goal is a percent from 1 to 100."
msgstr "लक्ष्य 1 से 100 के बीच का प्रतिशत होता है।"

#: openlibrary/contribute/manage.py
msgid "That date isn't one we can read."
msgstr "यह ऐसी तारीख नहीं है जिसे हम पढ़ सकें।"

#: openlibrary/contribute/manage.py
msgid "A project needs a title."
msgstr "परियोजना के लिए शीर्षक ज़रूरी है।"

#: openlibrary/contribute/manage.py
msgid "The title or description is too long."
msgstr "शीर्षक या विवरण बहुत लंबा है।"

#: openlibrary/contribute/manage.py
msgid "A project with an end date needs a start date."
msgstr "समाप्ति तारीख वाली परियोजना के लिए शुरुआत तारीख भी ज़रूरी है।"

#: openlibrary/contribute/manage.py
msgid "The end date is before the start date."
msgstr "समाप्ति तारीख शुरुआत तारीख से पहले है।"

#: openlibrary/contribute/manage.py
msgid "Not an Open Library ID or an ISBN"
msgstr "यह Open Library ID या ISBN नहीं है"

#: openlibrary/contribute/manage.py
msgid "No book has this ISBN"
msgstr "इस ISBN वाली कोई किताब नहीं है"

#: openlibrary/contribute/manage.py
msgid "No such book"
msgstr "ऐसी कोई किताब नहीं है"

#: openlibrary/contribute/manage.py
msgid "Not a book"
msgstr "यह किताब नहीं है"

#: openlibrary/contribute/manage.py
msgid "This work has no editions"
msgstr "इस कृति का कोई संस्करण नहीं है"

#: openlibrary/contribute/manage.py
msgid "Listed twice"
msgstr "दो बार सूचीबद्ध"

#: openlibrary/contribute/manage.py
msgid "Another edition of the same work is already listed"
msgstr "इसी कृति का एक और संस्करण पहले से सूचीबद्ध है"

#: openlibrary/contribute/manage.py
#, python-format
msgid "Past the limit of %(count)s books"
msgstr "%(count)s किताबों की सीमा से आगे"

#: openlibrary/contribute/manage.py
msgid "None yet"
msgstr "अभी तक कोई नहीं"

#: openlibrary/contribute/manage.py
msgid "Every book on the list"
msgstr "सूची की हर किताब"

#: openlibrary/contribute/manage.py
msgid "About the edition"
msgstr "संस्करण के बारे में"

#: openlibrary/contribute/manage.py
msgid "About the work"
msgstr "कृति के बारे में"

#: openlibrary/contribute/manage.py
msgid "Custom list"
msgstr "कस्टम सूची"

#: openlibrary/contribute/manage.py
msgid "(work IDs, book URLs, or ISBNs)"
msgstr "(कृति IDs, किताब URLs, या ISBNs)"

#: openlibrary/contribute/manage.py
msgid "Open Library list"
msgstr "Open Library सूची"

#: openlibrary/contribute/manage.py
msgid "Most-shelved books"
msgstr "सबसे ज़्यादा शेल्फ़ की गई किताबें"

#: openlibrary/contribute/manage.py
msgid "Choose at least one detail for the project to ask for."
msgstr "परियोजना के लिए पूछने हेतु कम से कम एक विवरण चुनें।"

#: openlibrary/contribute/manage.py
msgid "Choose where the books come from."
msgstr "चुनें कि किताबें कहां से आएं।"

#: openlibrary/contribute/manage.py
#, python-format
msgid "Choose how many books, from 1 to %(count)s."
msgstr "चुनें कितनी किताबें, 1 से %(count)s तक।"

#: openlibrary/contribute/manage.py
msgid "That isn't an Open Library list we can find."
msgstr "यह ऐसी Open Library सूची नहीं है जो हमें मिल सके।"

#: openlibrary/contribute/manage.py
msgid "None of those are books the project can use."
msgstr "इनमें से कोई भी ऐसी किताब नहीं है जिसे परियोजना उपयोग कर सके।"

#: openlibrary/contribute/save.py
msgid "Pick a language from the list."
msgstr "सूची में से एक भाषा चुनें।"

#: openlibrary/contribute/save.py
msgid "Enter the page count as a whole number."
msgstr "पृष्ठों की संख्या एक पूर्ण संख्या के रूप में दर्ज करें।"

#: openlibrary/contribute/save.py
msgid "This ISBN is already on another edition. Compare them: if they're the same book, this record is probably a duplicate."
msgstr "यह ISBN पहले से ही किसी और संस्करण पर है। दोनों की तुलना करें: अगर यह एक ही किताब है, तो यह रिकॉर्ड शायद डुप्लिकेट है।"

#: openlibrary/contribute/save.py
msgid "That isn't a valid ISBN. Check the digits: an ISBN has 10 or 13, and the last one is a check digit."
msgstr "यह मान्य ISBN नहीं है। अंक जाँचें: ISBN में 10 या 13 अंक होते हैं, और आख़िरी एक चेक अंक होता है।"

#: openlibrary/contribute/save.py
msgid "That year doesn't look right. Enter the year this edition came out."
msgstr "यह वर्ष सही नहीं लगता। वह वर्ष दर्ज करें जब यह संस्करण प्रकाशित हुआ था।"

#: openlibrary/contribute/save.py
msgid "Enter the date with its year, for example 2005 or March 2005."
msgstr "वर्ष सहित तिथि दर्ज करें, उदाहरण के लिए 2005 या मार्च 2005।"

#: openlibrary/contribute/save.py
msgid "Put the earlier year first, for example 1998-2002."
msgstr "पहले का वर्ष पहले दर्ज करें, उदाहरण के लिए 1998-2002।"

#: openlibrary/contribute/save.py
msgid "Fill in an answer, or choose “I couldn't find it”."
msgstr "एक जवाब भरें, या “मुझे यह नहीं मिला” चुनें।"

#: openlibrary/contribute/save.py
msgid "This field can't be filled in here."
msgstr "यह फ़ील्ड यहां नहीं भरी जा सकती।"

#: openlibrary/contribute/save.py
#, python-format
msgid "Filled in %(field)s from Open Library Tasks"
msgstr "ओपन लाइब्रेरी कार्यों से %(field)s भरा गया"

#: openlibrary/contribute/save.py
msgid "Pick at least one genre, or choose “Not sure”."
msgstr "कम से कम एक शैली चुनें, या “निश्चित नहीं” चुनें।"

#: openlibrary/contribute/save.py
msgid "Choose one of the options."
msgstr "विकल्पों में से एक चुनें।"

#: openlibrary/contribute/save.py
msgid "Choose an image of the cover."
msgstr "कवर की एक छवि चुनें।"

#: openlibrary/contribute/save.py
msgid "We couldn't save the cover just now. Please try again in a minute."
msgstr "हम अभी कवर को सहेज नहीं सके। कृपया एक मिनट बाद फिर से प्रयास करें।"

#: openlibrary/contribute/save.py
msgid "That isn't an image Open Library can use. Choose a JPG, GIF, PNG or WebP under 10 MB."
msgstr "यह ऐसी छवि नहीं है जिसे Open Library उपयोग कर सके। 10 MB से कम का JPG, GIF, PNG या WebP चुनें।"

#: openlibrary/core/bookshelves.py
msgid "[Record deleted]"
msgstr "[रिकॉर्ड हटाया गया]"

#: openlibrary/core/edits.py
msgid "Unknown"
msgstr "अज्ञात"

#: openlibrary/core/shell/nav.py openlibrary/fastapi/library_explorer.py openlibrary/plugins/upstream/code.py
msgid "Library Explorer"
msgstr "लाइब्रेरी एक्सप्लोरर"

#: openlibrary/core/shell/nav.py
msgid "K-12 Student Library"
msgstr "K -12 स्टूडेंट लाइब्रेरी"

#: openlibrary/core/shell/nav.py
msgid "Book Talks"
msgstr "बुक टॉक्स"

#: openlibrary/core/shell/nav.py
msgid "Random Book"
msgstr "रैंडम बुक"

#: openlibrary/core/tags.py
msgid "Novels, stories, plays and poems."
msgstr "उपन्यास, कहानियाँ, नाटक और कविताएँ।"

#: openlibrary/core/tags.py
msgid "History, biography, memoir, essays, how-to and reference."
msgstr "इतिहास, जीवनी, संस्मरण, निबंध, मार्गदर्शिका और संदर्भ ग्रंथ।"

#: openlibrary/core/tags.py
msgid "Hard to call, like a book based on a true story or a collection that mixes fiction and nonfiction."
msgstr "तय करना मुश्किल है, जैसे किसी सच्ची घटना पर आधारित किताब या कल्पित और अकल्पित को मिलाने वाला संग्रह।"

#: openlibrary/edition_scorecard.py
msgid "Can be accessed in full online (read / borrowed)"
msgstr "पूरी तरह ऑनलाइन एक्सेस किया जा सकता है (पढ़ें / उधार लें)"

#: openlibrary/edition_scorecard.py
msgid "Borrowable and readable books can be accessed by readers, researchers, and all patrons alike."
msgstr "उधार ली जा सकने वाली और पढ़ी जा सकने वाली किताबों को पाठक, शोधकर्ता, और सभी उपयोगकर्ता एक जैसे एक्सेस कर सकते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Can view snippets via search inside"
msgstr "'खोज अंदर' के ज़रिए अंश देखे जा सकते हैं"

#: openlibrary/edition_scorecard.py
msgid "Books that allow search inside enable patrons to quickly find relevant content within the book."
msgstr "जिन किताबों में 'अंदर खोजें' सुविधा होती है, वे उपयोगकर्ताओं को किताब के भीतर प्रासंगिक सामग्री जल्दी खोजने में मदद करती हैं।"

#: openlibrary/edition_scorecard.py
msgid "Open access (can analyze in full)"
msgstr "खुली पहुंच (पूरी तरह विश्लेषण किया जा सकता है)"

#: openlibrary/edition_scorecard.py
msgid "Fully public books can be read online or downloaded without any restrictions, providing excellent access for patrons."
msgstr "पूरी तरह सार्वजनिक किताबों को बिना किसी प्रतिबंध के ऑनलाइन पढ़ा या डाउनलोड किया जा सकता है, जिससे उपयोगकर्ताओं को बेहतरीन पहुंच मिलती है।"

#: openlibrary/edition_scorecard.py
msgid "Has purchase options"
msgstr "खरीदने के विकल्प उपलब्ध हैं"

#: openlibrary/edition_scorecard.py
msgid "An ISBN, Amazon ASIN identifier, or BWB identifier enables patrons to purchase the book from retailers."
msgstr "ISBN, Amazon ASIN पहचानकर्ता, या BWB पहचानकर्ता उपयोगकर्ताओं को रिटेलर्स से किताब खरीदने में सक्षम बनाता है।"

#: openlibrary/edition_scorecard.py
msgid "Has library options (ISBN or OCLC)"
msgstr "लाइब्रेरी विकल्प उपलब्ध हैं (ISBN या OCLC)"

#: openlibrary/edition_scorecard.py
msgid "ISBN or OCLC numbers enable patrons to find the book through library catalogs."
msgstr "ISBN या OCLC नंबर उपयोगकर्ताओं को लाइब्रेरी कैटलॉग के ज़रिए किताब खोजने में सक्षम बनाते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has fan fiction link (Archive of Our Own)"
msgstr "फैन फिक्शन लिंक मौजूद है (Archive of Our Own)"

#: openlibrary/edition_scorecard.py
msgid "A link to Archive of Our Own helps readers discover related fan-created works."
msgstr "Archive of Our Own का लिंक पाठकों को संबंधित फैन-निर्मित कृतियों को खोजने में मदद करता है।"

#: openlibrary/edition_scorecard.py
msgid "Has Wikipedia link"
msgstr "विकिपीडिया लिंक मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "A Wikipedia link provides additional context and encyclopedic information about the work."
msgstr "विकिपीडिया लिंक कृति के बारे में अतिरिक्त संदर्भ और विश्वकोशीय जानकारी प्रदान करता है।"

#: openlibrary/edition_scorecard.py
msgid "Has first sentence"
msgstr "पहला वाक्य मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "The first sentence gives patrons an immediate taste of the writing style."
msgstr "पहला वाक्य उपयोगकर्ताओं को लेखन शैली का तुरंत अंदाज़ा देता है।"

#: openlibrary/edition_scorecard.py
msgid "Has title field"
msgstr "शीर्षक फ़ील्ड मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "A title is essential for discovery and helps patrons identify the book in search results and catalogs."
msgstr "खोज के लिए शीर्षक आवश्यक है और यह उपयोगकर्ताओं को खोज परिणामों और कैटलॉग में किताब पहचानने में मदद करता है।"

#: openlibrary/edition_scorecard.py
msgid "Has author information"
msgstr "लेखक की जानकारी मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Author information is crucial for discovery and helps patrons find other works by the same author."
msgstr "खोज के लिए लेखक की जानकारी महत्वपूर्ण है और यह उपयोगकर्ताओं को उसी लेखक की अन्य कृतियां खोजने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has genre/category tags"
msgstr "विधा/श्रेणी टैग मौजूद हैं"

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons search by genre or category to discover relevant books."
msgstr "विधा टैग उपयोगकर्ताओं को विधा या श्रेणी के आधार पर प्रासंगिक किताबें खोजने में मदद करते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has series information"
msgstr "श्रृंखला की जानकारी मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons search by series and discover related books."
msgstr "श्रृंखला की जानकारी उपयोगकर्ताओं को श्रृंखला के आधार पर खोजने और संबंधित किताबें खोजने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has table of contents"
msgstr "विषय-सूची मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Table of contents entries are indexed and searchable, improving discoverability."
msgstr "विषय-सूची की प्रविष्टियां इंडेक्स की जाती हैं और खोजी जा सकती हैं, जिससे खोजने की क्षमता बेहतर होती है।"

#: openlibrary/edition_scorecard.py
msgid "Has DDC or LCC classification"
msgstr "DDC या LCC वर्गीकरण मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Dewey Decimal or Library of Congress classifications help with organization and shelf browsing."
msgstr "ड्यूई डेसिमल या लाइब्रेरी ऑफ़ कांग्रेस वर्गीकरण व्यवस्थित करने और शेल्फ ब्राउज़िंग में मदद करते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has language information"
msgstr "भाषा की जानकारी मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Language information helps patrons filter and find books in their preferred language."
msgstr "भाषा की जानकारी उपयोगकर्ताओं को अपनी पसंदीदा भाषा में किताबें फ़िल्टर करने और खोजने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has ISBN"
msgstr "ISBN मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "ISBNs allow searching by barcode scanner and help with identification."
msgstr "ISBN बारकोड स्कैनर से खोज की अनुमति देते हैं और पहचान में मदद करते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has Lexile measure"
msgstr "लेक्साइल माप मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Lexile measures help educators and parents find books at the appropriate reading level."
msgstr "लेक्साइल माप शिक्षकों और माता-पिता को उचित पठन स्तर पर किताबें खोजने में मदद करते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (ranking signal)"
msgstr "स्टार रेटिंग मौजूद है (रैंकिंग संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings contribute to search ranking so better-rated books surface higher."
msgstr "स्टार रेटिंग खोज रैंकिंग में योगदान देती हैं ताकि बेहतर रेटिंग वाली किताबें ऊपर दिखें।"

#: openlibrary/edition_scorecard.py
msgid "Appears on reading logs (ranking signal)"
msgstr "रीडिंग लॉग में दिखाई देती है (रैंकिंग संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Presence on reading logs is a popularity signal that helps with search ranking."
msgstr "रीडिंग लॉग में मौजूदगी एक लोकप्रियता संकेत है जो खोज रैंकिंग में मदद करता है।"

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (ranking signal)"
msgstr "सूचियों में दिखाई देती है (रैंकिंग संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Presence on user lists is a popularity signal that helps with search ranking."
msgstr "उपयोगकर्ता सूचियों में मौजूदगी एक लोकप्रियता संकेत है जो खोज रैंकिंग में मदद करता है।"

#: openlibrary/edition_scorecard.py
msgid "Has contributor names"
msgstr "योगदानकर्ताओं के नाम मौजूद हैं"

#: openlibrary/edition_scorecard.py
msgid "Contributor names (editors, illustrators, translators) enable searching by contributor."
msgstr "योगदानकर्ताओं के नाम (संपादक, चित्रकार, अनुवादक) योगदानकर्ता के आधार पर खोज को सक्षम बनाते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Has a description"
msgstr "विवरण मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "A description helps patrons understand what the book is about before accessing it."
msgstr "विवरण उपयोगकर्ताओं को एक्सेस करने से पहले यह समझने में मदद करता है कि किताब किस बारे में है।"

#: openlibrary/edition_scorecard.py
msgid "Has cover image"
msgstr "कवर छवि मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "A cover image helps patrons visually identify the book and makes it more appealing in search results."
msgstr "कवर छवि उपयोगकर्ताओं को किताब को दृश्य रूप से पहचानने में मदद करती है और इसे खोज परिणामों में अधिक आकर्षक बनाती है।"

#: openlibrary/edition_scorecard.py
msgid "A table of contents helps patrons evaluate the structure and scope of the book."
msgstr "विषय-सूची उपयोगकर्ताओं को किताब की संरचना और दायरे का आकलन करने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons quickly assess whether a book matches their interests."
msgstr "विधा टैग उपयोगकर्ताओं को यह जल्दी आकलन करने में मदद करते हैं कि किताब उनकी रुचियों से मेल खाती है या नहीं।"

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (popularity signal)"
msgstr "स्टार रेटिंग मौजूद है (लोकप्रियता संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings from other readers help patrons gauge the quality and reception of the book."
msgstr "अन्य पाठकों की स्टार रेटिंग उपयोगकर्ताओं को किताब की गुणवत्ता और स्वागत का अंदाज़ा लगाने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has a rich description (50+ characters)"
msgstr "विस्तृत विवरण मौजूद है (50+ अक्षर)"

#: openlibrary/edition_scorecard.py
msgid "A detailed description (50+ characters) provides more context to help patrons evaluate relevance."
msgstr "एक विस्तृत विवरण (50+ अक्षर) अधिक संदर्भ प्रदान करता है जिससे उपयोगकर्ताओं को प्रासंगिकता आंकने में मदद मिलती है।"

#: openlibrary/edition_scorecard.py
msgid "Has reading log activity (popularity signal)"
msgstr "रीडिंग लॉग गतिविधि मौजूद है (लोकप्रियता संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Reading log activity from other patrons signals the book is being actively read."
msgstr "अन्य उपयोगकर्ताओं की रीडिंग लॉग गतिविधि यह संकेत देती है कि किताब को सक्रिय रूप से पढ़ा जा रहा है।"

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (popularity signal)"
msgstr "सूचियों में दिखाई देती है (लोकप्रियता संकेत)"

#: openlibrary/edition_scorecard.py
msgid "Presence on curated lists helps patrons gauge relevance and community interest."
msgstr "चयनित सूचियों में मौजूदगी उपयोगकर्ताओं को प्रासंगिकता और सामुदायिक रुचि का अंदाज़ा लगाने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has page count"
msgstr "पृष्ठों की संख्या मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "Page count helps patrons estimate the length and time commitment of the book."
msgstr "पृष्ठों की संख्या उपयोगकर्ताओं को किताब की लंबाई और समय की प्रतिबद्धता का अनुमान लगाने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons understand the book's place in a broader narrative."
msgstr "श्रृंखला की जानकारी उपयोगकर्ताओं को व्यापक कथा में किताब का स्थान समझने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has author photo"
msgstr "लेखक की तस्वीर मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "An author photo helps patrons visually recognize the author."
msgstr "लेखक की तस्वीर उपयोगकर्ताओं को लेखक को दृश्य रूप से पहचानने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has first publication year"
msgstr "पहले प्रकाशन का वर्ष मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "The first publication year helps patrons understand when the work originally appeared."
msgstr "पहले प्रकाशन का वर्ष उपयोगकर्ताओं को यह समझने में मदद करता है कि कृति मूल रूप से कब प्रकाशित हुई थी।"

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
msgid "Has publication year"
msgstr "प्रकाशन वर्ष है"

#: openlibrary/edition_scorecard.py
msgid "Publication year helps patrons understand the context and currency of the content."
msgstr "प्रकाशन वर्ष उपयोगकर्ताओं को सामग्री के संदर्भ और वर्तमानता को समझने में मदद करता है।"

#: openlibrary/edition_scorecard.py
msgid "Has author biography"
msgstr "लेखक की जीवनी मौजूद है"

#: openlibrary/edition_scorecard.py
msgid "An author biography helps patrons understand the author's background and expertise."
msgstr "लेखक की जीवनी उपयोगकर्ताओं को लेखक की पृष्ठभूमि और विशेषज्ञता समझने में मदद करती है।"

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
msgid "Has publisher"
msgstr "प्रकाशक है"

#: openlibrary/edition_scorecard.py
msgid "Publisher information helps patrons evaluate the credibility and source of the book."
msgstr "प्रकाशक की जानकारी उपयोगकर्ताओं को किताब की विश्वसनीयता और स्रोत का आकलन करने में मदद करती है।"

#: openlibrary/edition_scorecard.py
msgid "Has author links"
msgstr "लेखक के लिंक मौजूद हैं"

#: openlibrary/edition_scorecard.py
msgid "Links to author websites or profiles provide additional context about the author."
msgstr "लेखक की वेबसाइटों या प्रोफ़ाइलों के लिंक लेखक के बारे में अतिरिक्त संदर्भ प्रदान करते हैं।"

#: openlibrary/edition_scorecard.py
msgid "Edition Scorecard"
msgstr "संस्करण स्कोरकार्ड"

#: openlibrary/edition_scorecard.py
msgid "Discovery"
msgstr "खोज"

#: openlibrary/edition_scorecard.py
msgid "How well can this edition be accurately surfaced in searches and recommendations?"
msgstr "यह संस्करण खोजों और सिफारिशों में कितनी सटीकता से सामने आ सकता है?"

#: openlibrary/edition_scorecard.py
msgid "Evaluation"
msgstr "मूल्यांकन"

#: openlibrary/edition_scorecard.py
msgid "How well can a patron determine if this edition is relevant to their needs before accessing it?"
msgstr "एक उपयोगकर्ता एक्सेस करने से पहले यह कितनी अच्छी तरह तय कर सकता है कि यह संस्करण उनकी ज़रूरतों के लिए प्रासंगिक है?"

