msgstr "परियोजना को फिर से दृश्यमान बनाया"

#: openlibrary/contribute/manage.py
msgid "Stopped the project early"
msgstr "परियोजना को जल्दी रोका"

#: openlibrary/contribute/manage.py
msgid "Made it the featured project"
msgstr "इसे फ़ीचर्ड परियोजना बनाया"

#: openlibrary/contribute/manage.py
msgid "Another project was featured"
msgstr "कोई और परियोजना फ़ीचर की गई"

