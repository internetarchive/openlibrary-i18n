#: openlibrary/contribute/field_guides.py
msgid "WorldCat"
msgstr "WorldCat"

#: openlibrary/contribute/field_guides.py
msgid "Google Books"
msgstr "Google Books"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/partials.py
msgid "Amazon"
msgstr "Amazon"

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress"
msgstr "Library of Congress"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Cover"
msgstr "मुखपृष्ठ"

#: openlibrary/contribute/field_guides.py
msgid "Add a cover"
msgstr "मुखपृष्ठ जोडा"

#: openlibrary/contribute/field_guides.py
msgid "Can you find this edition's cover?"
msgstr "तुम्हाला या संस्करणाचे मुखपृष्ठ सापडू शकते का?"

#: openlibrary/contribute/field_guides.py
msgid "Look the ISBN up on Google Books, Amazon or Better World Books and save the front cover image. Check that the title, author and publisher on the image match this edition, then upload it here."
msgstr "Google Books, Amazon किंवा Better World Books वर ISBN शोधा आणि मुखपृष्ठ प्रतिमा जतन करा. प्रतिमेवरील शीर्षक, लेखक आणि प्रकाशक हे संस्करणाशी जुळतात का ते तपासा, नंतर ती येथे अपलोड करा."

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/partials.py
msgid "Better World Books"
msgstr "Better World Books"

#: openlibrary/contribute/field_guides.py
msgid "Upload the cover only, flat and in full: no photos of the book on a table, no 3D mockups, no store badges or watermarks."
msgstr "फक्त मुखपृष्ठ अपलोड करा, सपाट आणि पूर्ण: टेबलवरील पुस्तकाचे फोटो नकोत, 3D मॉकअप्स नकोत, स्टोअर बॅजेस किंवा वॉटरमार्क्स नकोत."

#: openlibrary/contribute/field_guides.py
msgid "Making a cover yourself. If you can't find the real one, leave it for someone who can."
msgstr "स्वतः मुखपृष्ठ बनवणे. तुम्हाला खरे सापडत नसल्यास, ते सापडू शकणाऱ्या कोणासाठी तरी सोडा."

#: openlibrary/contribute/field_guides.py
msgid "Look for anything that doesn't fit this edition, such as “Graphic Novel”, “Movie tie-in” or a title in another language."
msgstr "या संस्करणाला न जुळणारे काहीही शोधा, जसे की \"Graphic Novel\", \"Movie tie-in\" किंवा दुसऱ्या भाषेतील शीर्षक."

#: openlibrary/contribute/field_guides.py
msgid "Fill in language"
msgstr "भाषा भरा"

#: openlibrary/contribute/field_guides.py
msgid "Start with the title, subtitle and publisher on this page. Then look the ISBN up: WorldCat lists the language, and Google Books shows a “Translated by” line when the edition is a translation."
msgstr "या पृष्ठावरील शीर्षक, उपशीर्षक आणि प्रकाशकापासून सुरुवात करा. नंतर ISBN शोधा: WorldCat भाषा सूचीबद्ध करते, आणि संस्करण भाषांतर असल्यास Google Books \"Translated by\" ओळ दाखवते."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the text itself, and a translation names its translator on the title page."
msgstr "%(link_start)sस्कॅन%(link_end)s मजकूर स्वतः दाखवतो, आणि भाषांतर शीर्षक पृष्ठावर त्याच्या भाषांतरकाराचे नाव देते."

#: openlibrary/contribute/field_guides.py
msgid "Editions of a work usually share a language, but a translation won't. Check this edition's own text."
msgstr "कृतीची संस्करणे सहसा एकच भाषा सामायिक करतात, पण भाषांतर करणार नाही. या संस्करणाचा स्वतःचा मजकूर तपासा."

#: openlibrary/contribute/field_guides.py
msgid "Record the language of the text, not the language of the title page. A translation is in the language it was translated into."
msgstr "मजकुराची भाषा नोंदवा, शीर्षक पृष्ठाची भाषा नाही. भाषांतर ज्या भाषेत भाषांतरित केले गेले त्या भाषेत असते."

#: openlibrary/contribute/field_guides.py
msgid "For example English"
msgstr "उदाहरणार्थ English"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Page count"
msgstr "पृष्ठ संख्या"

#: openlibrary/contribute/field_guides.py
msgid "Fill in page count"
msgstr "पृष्ठ संख्या भरा"

#: openlibrary/contribute/field_guides.py
msgid "How many pages does this edition have?"
msgstr "या संस्करणात किती पाने आहेत?"

#: openlibrary/contribute/field_guides.py
msgid "Google Books lists the page count as Length. WorldCat has it in the record's description, sometimes only after you sign in. Amazon's print length often counts every page, so use it to check a number rather than to find one."
msgstr "Google Books पृष्ठ संख्या Length म्हणून सूचीबद्ध करते. WorldCat मध्ये ती नोंदीच्या वर्णनात असते, कधीकधी फक्त साइन इन केल्यावरच. Amazon ची print length सहसा प्रत्येक पान मोजते, त्यामुळे संख्या शोधण्याऐवजी तपासण्यासाठी तिचा वापर करा."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s has every page. Go to the end of the main text and use the last numbered page."
msgstr "%(link_start)sस्कॅन%(link_end)s मध्ये प्रत्येक पान आहे. मुख्य मजकुराच्या शेवटी जा आणि शेवटचे क्रमांकित पान वापरा."

#: openlibrary/contribute/field_guides.py
msgid "Catalogs count front matter differently, so numbers within a few pages of each other are the same count. Use the last numbered page of the main text."
msgstr "कॅटलॉग्स front matter वेगळ्या पद्धतीने मोजतात, त्यामुळे काही पानांच्या फरकातील संख्या हीच गणना मानली जाते. मुख्य मजकुराचे शेवटचे क्रमांकित पान वापरा."

#: openlibrary/contribute/field_guides.py
msgid "For example 320"
msgstr "उदाहरणार्थ 320"

#: openlibrary/contribute/field_guides.py
msgid "Literary form"
msgstr "साहित्यिक स्वरूप"

#: openlibrary/contribute/field_guides.py
msgid "Pick fiction or nonfiction"
msgstr "काल्पनिक किंवा अकाल्पनिक निवडा"

#: openlibrary/contribute/field_guides.py
msgid "Is this book fiction or nonfiction?"
msgstr "हे पुस्तक काल्पनिक आहे की अकाल्पनिक?"

#: openlibrary/contribute/field_guides.py
msgid "Google Books lists Categories such as Fiction / Fantasy, and WorldCat lists Genre headings such as Fiction or Biography."
msgstr "Google Books Fiction / Fantasy सारख्या Categories सूचीबद्ध करते, आणि WorldCat Fiction किंवा Biography सारख्या Genre headings सूचीबद्ध करते."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the back cover and any jacket flaps, which usually say what kind of book it is."
msgstr "%(link_start)sस्कॅन%(link_end)s मागील मुखपृष्ठ आणि कोणतेही जॅकेट फ्लॅप्स दाखवतो, जे सहसा हे कोणत्या प्रकारचे पुस्तक आहे हे सांगतात."

#: openlibrary/contribute/field_guides.py
msgid "Nonfiction can read like a story. A memoir that bends the truth is still nonfiction: it is presented as fact."
msgstr "अकाल्पनिक कथेसारखे वाचता येऊ शकते. सत्य वाकवणारे आठवणीवजा पुस्तकही अकाल्पनिकच असते: ते वस्तुस्थिती म्हणून सादर केले जाते."

#: openlibrary/contribute/field_guides.py
msgid "Anthologies and collections take the form of what's inside. A book of essays about novels is nonfiction."
msgstr "काव्यसंग्रह आणि संग्रह आतील सामग्रीचे स्वरूप घेतात. कादंबऱ्यांबद्दलच्या निबंधांचे पुस्तक अकाल्पनिक असते."

#: openlibrary/contribute/field_guides.py
msgid "Genres"
msgstr "प्रकार"

#: openlibrary/contribute/field_guides.py
msgid "Pick genres"
msgstr "प्रकार निवडा"

#: openlibrary/contribute/field_guides.py
msgid "Which genres fit this book?"
msgstr "या पुस्तकाला कोणते प्रकार लागू होतात?"

#: openlibrary/contribute/field_guides.py
msgid ""
"Start with the record: the subjects, and the description when there is one. If you know the book, pick from what you know.\n"
"\n"
"Otherwise look it up. Google Books lists Categories such as Fiction / Horror, WorldCat lists Genre/Form headings such as Fantasy fiction, and Goodreads shows what readers shelve it as."
msgstr ""
"नोंदीपासून सुरुवात करा: विषय, आणि वर्णन असल्यास ते. तुम्हाला पुस्तक माहीत असल्यास, तुम्हाला माहीत असलेल्यातून निवडा.\n"
"\n"
"नाहीतर ते शोधा. Google Books Fiction / Horror सारख्या Categories सूचीबद्ध करते, WorldCat Fantasy fiction सारख्या Genre/Form headings सूचीबद्ध करते, आणि Goodreads वाचक त्याला कोणत्या शेल्फवर ठेवतात ते दाखवते."

#: openlibrary/contribute/field_guides.py
msgid "Goodreads"
msgstr "Goodreads"

#: openlibrary/contribute/field_guides.py
msgid "Go by what the book is sold as, not every element in it. A fantasy with a love story is fantasy; a love story in a fantasy setting is romance."
msgstr "पुस्तक ज्या प्रकारे विकले जाते त्यानुसार जा, त्यातील प्रत्येक घटकानुसार नाही. प्रेमकथा असलेली फँटसी ही फँटसीच असते; फँटसी पार्श्वभूमीवरील प्रेमकथा रोमान्स असते."

#: openlibrary/contribute/field_guides.py
msgid "Children's and young adult are audiences, not genres, and a subject of just “Fiction” says nothing about genre. With nothing more to go on, choose Not sure."
msgstr "मुलांसाठी आणि किशोरवयीनांसाठी हे प्रेक्षकवर्ग आहेत, प्रकार नाहीत, आणि फक्त \"Fiction\" हा विषय प्रकाराबद्दल काहीही सांगत नाही. आणखी काही आधार नसल्यास, खात्री नाही निवडा."

#: openlibrary/contribute/field_guides.py
msgid "Pick every genre that fits. Not sure of one? Leave it out."
msgstr "लागू होणारा प्रत्येक प्रकार निवडा. एखाद्याबद्दल खात्री नाही? तो वगळा."

#: openlibrary/contribute/field_guides.py
msgid "Fill in publisher"
msgstr "प्रकाशक भरा"

#: openlibrary/contribute/field_guides.py
msgid "Who published this edition?"
msgstr "हे संस्करण कोणी प्रकाशित केले?"

#: openlibrary/contribute/field_guides.py
msgid "The imprint is printed on the title page and the spine. The Library of Congress copies it from the title page, and WorldCat lists it under Publisher. Google Books often names the parent company instead."
msgstr "छाप शीर्षक पृष्ठावर आणि मणक्यावर छापलेली असते. Library of Congress ती शीर्षक पृष्ठावरून कॉपी करते, आणि WorldCat ती Publisher अंतर्गत सूचीबद्ध करते. Google Books सहसा त्याऐवजी मूळ कंपनीचे नाव देते."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the title page. Copy the imprint as it's printed there."
msgstr "%(link_start)sस्कॅन%(link_end)s शीर्षक पृष्ठ दाखवतो. तेथे छापलेली छाप जशीच्या तशी कॉपी करा."

#: openlibrary/contribute/field_guides.py
msgid "Open Library records the imprint printed on the book, not the parent company. Anchor Books, not Penguin Random House."
msgstr "Open Library पुस्तकावर छापलेली छाप नोंदवते, मूळ कंपनी नाही. Anchor Books, Penguin Random House नाही."

#: openlibrary/contribute/field_guides.py
msgid "Publisher as printed"
msgstr "छापल्याप्रमाणे प्रकाशक"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Publish date"
msgstr "प्रकाशन तारीख"

#: openlibrary/contribute/field_guides.py
msgid "Fill in publish date"
msgstr "प्रकाशन तारीख भरा"

#: openlibrary/contribute/field_guides.py
msgid "When was this edition published?"
msgstr "हे संस्करण कधी प्रकाशित झाले?"

#: openlibrary/contribute/field_guides.py
msgid "The copyright page gives the year, often next to the publisher. Google Books lists it as Published, WorldCat as Date, and the Library of Congress record as part of the Published line."
msgstr "कॉपीराइट पृष्ठ वर्ष देते, सहसा प्रकाशकाच्या शेजारी. Google Books ते Published म्हणून, WorldCat Date म्हणून, आणि Library of Congress नोंद Published ओळीचा भाग म्हणून सूचीबद्ध करते."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page, which gives the year this edition came out."
msgstr "%(link_start)sस्कॅन%(link_end)s कॉपीराइट पृष्ठ दाखवतो, जो हे संस्करण कधी आले ते वर्ष देतो."

#: openlibrary/contribute/field_guides.py
msgid "Enter the year this edition came out, or the full date if a catalog gives one, such as March 2005. A later printing of the same edition keeps the edition's year."
msgstr "हे संस्करण कधी आले ते वर्ष प्रविष्ट करा, किंवा कॅटलॉगने दिल्यास पूर्ण तारीख, जसे की March 2005. त्याच संस्करणाची नंतरची छपाई संस्करणाचे वर्षच ठेवते."

#: openlibrary/contribute/field_guides.py
msgid "For example 2005 or March 2005"
msgstr "उदाहरणार्थ 2005 किंवा March 2005"

#: openlibrary/contribute/field_guides.py
msgid "Fill in ISBN"
msgstr "ISBN भरा"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's ISBN?"
msgstr "या संस्करणाचा ISBN काय आहे?"

#: openlibrary/contribute/field_guides.py
msgid "The ISBN is printed on the copyright page and on the back cover, above the barcode. Without the book in hand, search WorldCat or Google Books by title and author, open the record whose publisher, year and format match this one, and copy the ISBN it lists."
msgstr "ISBN कॉपीराइट पृष्ठावर आणि मागील मुखपृष्ठावर, बारकोडच्या वर छापलेला असतो. पुस्तक हातात नसल्यास, शीर्षक आणि लेखकाने WorldCat किंवा Google Books शोधा, ज्याचा प्रकाशक, वर्ष आणि स्वरूप यासारखे जुळते ती नोंद उघडा, आणि तिने सूचीबद्ध केलेला ISBN कॉपी करा."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page and the back cover, where the ISBN is printed."
msgstr "%(link_start)sस्कॅन%(link_end)s कॉपीराइट पृष्ठ आणि मागील मुखपृष्ठ दाखवतो, जेथे ISBN छापलेला असतो."

#: openlibrary/contribute/field_guides.py
msgid "An ISBN-10 and an ISBN-13 can name the same edition: 0140449264 and 9780140449266. Paste either, with or without hyphens. Books from before 1970 don't have one."
msgstr "ISBN-10 आणि ISBN-13 एकाच संस्करणाला नाव देऊ शकतात: 0140449264 आणि 9780140449266. कोणताही पेस्ट करा, हायफनसह किंवा त्याशिवाय. 1970 पूर्वीच्या पुस्तकांना तो नसतो."

#: openlibrary/contribute/field_guides.py
msgid "The ISBN belongs to another format of the book: a hardcover, paperback, ebook and audiobook each have their own."
msgstr "ISBN पुस्तकाच्या दुसऱ्या स्वरूपाचा आहे: हार्डकव्हर, पेपरबॅक, ईबुक आणि ऑडिओबुक यांचे स्वतःचे असतात."

#: openlibrary/contribute/field_guides.py
msgid "For example 9780140449266"
msgstr "उदाहरणार्थ 9780140449266"

#: openlibrary/contribute/field_guides.py
msgid "I checked that the publisher, year and format match this edition."
msgstr "मी तपासले की प्रकाशक, वर्ष आणि स्वरूप या संस्करणाशी जुळतात."

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress number (LCCN)"
msgstr "Library of Congress क्रमांक (LCCN)"

#: openlibrary/contribute/field_guides.py
msgid "Fill in LCCN"
msgstr "LCCN भरा"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's Library of Congress number?"
msgstr "या संस्करणाचा Library of Congress क्रमांक काय आहे?"

#: openlibrary/contribute/field_guides.py
msgid "Search the Library of Congress catalog for this ISBN, open the matching record and copy the number shown as LCCN."
msgstr "या ISBN साठी Library of Congress कॅटलॉग शोधा, जुळणारी नोंद उघडा आणि LCCN म्हणून दाखवलेला क्रमांक कॉपी करा."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page. Books from the 1970s on often print the LCCN there, in the cataloging data."
msgstr "%(link_start)sस्कॅन%(link_end)s कॉपीराइट पृष्ठ दाखवतो. 1970 च्या दशकापासूनची पुस्तके सहसा तेथे, कॅटलॉगिंग डेटामध्ये LCCN छापतात."

#: openlibrary/contribute/field_guides.py
msgid "Hyphenated and padded forms are the same number: 75-425165 and 75425165. Paste either; Open Library stores the padded form."
msgstr "हायफनयुक्त आणि पॅड केलेली रूपे एकच संख्या आहेत: 75-425165 आणि 75425165. कोणतेही पेस्ट करा; Open Library पॅड केलेले रूप साठवते."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different edition: another publisher's, a revised edition, a translation or the ebook. Each has its own record."
msgstr "हा क्रमांक वेगळ्या संस्करणाचा आहे: दुसऱ्या प्रकाशकाचे, सुधारित संस्करण, भाषांतर किंवा ईबुक. प्रत्येकाची स्वतःची नोंद असते."

#: openlibrary/contribute/field_guides.py
msgid "For example 75425165"
msgstr "उदाहरणार्थ 75425165"

#: openlibrary/contribute/field_guides.py
msgid "I opened the record and its publisher and edition match this one."
msgstr "मी नोंद उघडली आणि तिचा प्रकाशक आणि संस्करण याच्याशी जुळतात."

#: openlibrary/contribute/field_guides.py
msgid "OCLC/WorldCat number"
msgstr "OCLC/WorldCat क्रमांक"

#: openlibrary/contribute/field_guides.py
msgid "Fill in OCLC number"
msgstr "OCLC क्रमांक भरा"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's WorldCat (OCLC) number?"
msgstr "या संस्करणाचा WorldCat (OCLC) क्रमांक काय आहे?"

#: openlibrary/contribute/field_guides.py
msgid "Search WorldCat for this ISBN, open the matching print record and copy the number shown as OCLC Number."
msgstr "या ISBN साठी WorldCat शोधा, जुळणारी मुद्रित नोंद उघडा आणि OCLC Number म्हणून दाखवलेला क्रमांक कॉपी करा."

#: openlibrary/contribute/field_guides.py
msgid "The prefixes ocm, ocn, on and (OCoLC) are padding added by library systems, not part of the number. ocm00047810608 is 47810608."
msgstr "ocm, ocn, on आणि (OCoLC) हे उपसर्ग लायब्ररी सिस्टिमद्वारे जोडलेले पॅडिंग आहेत, क्रमांकाचा भाग नाहीत. ocm00047810608 म्हणजे 47810608."

#: openlibrary/contribute/field_guides.py
msgid "WorldCat sometimes lists one edition more than once. Any of those numbers is right; OCLC merges them over time."
msgstr "WorldCat कधीकधी एकच संस्करण एकापेक्षा जास्त वेळा सूचीबद्ध करते. त्यापैकी कोणताही क्रमांक बरोबर आहे; OCLC कालांतराने ते विलीन करते."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different record: the ebook, another publisher's edition, a revised edition, large print or a translation."
msgstr "हा क्रमांक वेगळ्या नोंदीचा आहे: ईबुक, दुसऱ्या प्रकाशकाचे संस्करण, सुधारित संस्करण, मोठी छपाई किंवा भाषांतर."

#: openlibrary/contribute/field_guides.py
msgid "Pasting the web address, or leaving the ocm/ocn prefix on."
msgstr "वेब पत्ता पेस्ट करणे, किंवा ocm/ocn उपसर्ग तसाच ठेवणे."

#: openlibrary/contribute/field_guides.py
msgid "Digits only, for example 47810608"
msgstr "फक्त अंक, उदाहरणार्थ 47810608"

#: openlibrary/contribute/field_guides.py
msgid "I opened a print record and its publisher and edition match this one."
msgstr "मी एक मुद्रित नोंद उघडली आणि तिचा प्रकाशक आणि संस्करण याच्याशी जुळतात."

#: openlibrary/contribute/field_guides.py
msgid "This edition has a Library of Congress record, which gives the language and the publisher as printed."
msgstr "या संस्करणाची Library of Congress नोंद आहे, जी भाषा आणि छापलेला प्रकाशक देते."

#: openlibrary/contribute/field_guides.py
