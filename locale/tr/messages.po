#: openlibrary/contribute/field_guides.py
msgid "WorldCat"
msgstr "WorldCat"

#: openlibrary/contribute/field_guides.py
msgid "Google Books"
msgstr "Google Books"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/partials.py
msgid "Amazon"
msgstr "Amazon"

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress"
msgstr "Library of Congress"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Cover"
msgstr "Kapak"

#: openlibrary/contribute/field_guides.py
msgid "Add a cover"
msgstr "Kapak ekle"

#: openlibrary/contribute/field_guides.py
msgid "Can you find this edition's cover?"
msgstr "Bu baskının kapağını bulabilir misiniz?"

#: openlibrary/contribute/field_guides.py
msgid "Look the ISBN up on Google Books, Amazon or Better World Books and save the front cover image. Check that the title, author and publisher on the image match this edition, then upload it here."
msgstr "ISBN'yi Google Kitaplar, Amazon veya Better World Books'ta arayın ve ön kapak görselini kaydedin. Görseldeki başlık, yazar ve yayıncının bu baskıyla eşleştiğinden emin olun, ardından buraya yükleyin."

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/partials.py
msgid "Better World Books"
msgstr "Better World Books"

#: openlibrary/contribute/field_guides.py
msgid "Upload the cover only, flat and in full: no photos of the book on a table, no 3D mockups, no store badges or watermarks."
msgstr "Yalnızca kapağı, düz ve eksiksiz şekilde yükleyin: masadaki kitabın fotoğrafları, 3D maketler, mağaza rozetleri veya filigranlar olmamalı."

#: openlibrary/contribute/field_guides.py
msgid "Making a cover yourself. If you can't find the real one, leave it for someone who can."
msgstr "Kendiniz bir kapak yapmak. Gerçek olanı bulamıyorsanız, bulabilecek birine bırakın."

#: openlibrary/contribute/field_guides.py
msgid "Look for anything that doesn't fit this edition, such as “Graphic Novel”, “Movie tie-in” or a title in another language."
msgstr "Bu baskıya uymayan herhangi bir şeye dikkat edin, örneğin “Çizgi Roman”, “Film uyarlaması” veya başka bir dildeki başlık."

#: openlibrary/contribute/field_guides.py
msgid "Fill in language"
msgstr "Dili doldurun"

#: openlibrary/contribute/field_guides.py
msgid "Start with the title, subtitle and publisher on this page. Then look the ISBN up: WorldCat lists the language, and Google Books shows a “Translated by” line when the edition is a translation."
msgstr "Bu sayfadaki başlık, alt başlık ve yayıncıyla başlayın. Ardından ISBN'yi arayın: WorldCat dili listeler ve Google Kitaplar, baskı bir çeviri olduğunda “Çeviren” satırını gösterir."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the text itself, and a translation names its translator on the title page."
msgstr "%(link_start)sTarama%(link_end)s metnin kendisini gösterir ve bir çeviri, iç kapakta çevirmenin adını belirtir."

#: openlibrary/contribute/field_guides.py
msgid "Editions of a work usually share a language, but a translation won't. Check this edition's own text."
msgstr "Bir eserin baskıları genellikle aynı dili paylaşır, ancak bir çeviri paylaşmaz. Bu baskının kendi metnini kontrol edin."

#: openlibrary/contribute/field_guides.py
msgid "Record the language of the text, not the language of the title page. A translation is in the language it was translated into."
msgstr "Başlık sayfasının dilini değil, metnin dilini kaydedin. Bir çeviri, çevrildiği dildedir."

#: openlibrary/contribute/field_guides.py
msgid "For example English"
msgstr "Örneğin İngilizce"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Page count"
msgstr "Sayfa sayısı"

#: openlibrary/contribute/field_guides.py
msgid "Fill in page count"
msgstr "Sayfa sayısını doldurun"

#: openlibrary/contribute/field_guides.py
msgid "How many pages does this edition have?"
msgstr "Bu baskının kaç sayfası var?"

#: openlibrary/contribute/field_guides.py
msgid "Google Books lists the page count as Length. WorldCat has it in the record's description, sometimes only after you sign in. Amazon's print length often counts every page, so use it to check a number rather than to find one."
msgstr "Google Books sayfa sayısını Length olarak listeler. WorldCat bunu kaydın açıklamasında verir, bazen yalnızca oturum açtıktan sonra. Amazon'un print length değeri genellikle her sayfayı sayar, bu yüzden bir sayı bulmak yerine bir sayıyı doğrulamak için kullanın."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s has every page. Go to the end of the main text and use the last numbered page."
msgstr "%(link_start)sTarama%(link_end)s her sayfayı içerir. Ana metnin sonuna gidin ve son numaralı sayfayı kullanın."

#: openlibrary/contribute/field_guides.py
msgid "Catalogs count front matter differently, so numbers within a few pages of each other are the same count. Use the last numbered page of the main text."
msgstr "Kataloglar ön kısmı farklı şekilde sayar, bu yüzden birbirine birkaç sayfa yakın rakamlar aynı sayı sayılır. Ana metnin son numaralandırılmış sayfasını kullanın."

#: openlibrary/contribute/field_guides.py
msgid "For example 320"
msgstr "Örneğin 320"

#: openlibrary/contribute/field_guides.py
msgid "Literary form"
msgstr "Edebi tür"

#: openlibrary/contribute/field_guides.py
msgid "Pick fiction or nonfiction"
msgstr "Kurgu veya kurgu dışı seçin"

#: openlibrary/contribute/field_guides.py
msgid "Is this book fiction or nonfiction?"
msgstr "Bu kitap kurgu mu, kurgu dışı mı?"

#: openlibrary/contribute/field_guides.py
msgid "Google Books lists Categories such as Fiction / Fantasy, and WorldCat lists Genre headings such as Fiction or Biography."
msgstr "Google Books, Fiction/Fantasy gibi kategoriler listeler ve WorldCat, Fiction veya Biography gibi tür başlıkları listeler."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the back cover and any jacket flaps, which usually say what kind of book it is."
msgstr "%(link_start)sTarama%(link_end)s arka kapağı ve varsa kapak kanatlarını gösterir; bunlar genellikle kitabın türünü belirtir."

#: openlibrary/contribute/field_guides.py
msgid "Nonfiction can read like a story. A memoir that bends the truth is still nonfiction: it is presented as fact."
msgstr "Kurgu dışı eserler bir hikaye gibi okunabilir. Gerçeği biraz eğip büken bir anı kitabı yine de kurgu dışıdır: gerçek olarak sunulur."

#: openlibrary/contribute/field_guides.py
msgid "Anthologies and collections take the form of what's inside. A book of essays about novels is nonfiction."
msgstr "Antolojiler ve derlemeler içeriklerinin biçimini alır. Romanlar hakkında denemelerden oluşan bir kitap kurgu dışıdır."

#: openlibrary/contribute/field_guides.py
msgid "Genres"
msgstr "Türler"

#: openlibrary/contribute/field_guides.py
msgid "Pick genres"
msgstr "Türleri seçin"

#: openlibrary/contribute/field_guides.py
msgid "Which genres fit this book?"
msgstr "Bu kitaba hangi türler uyuyor?"

#: openlibrary/contribute/field_guides.py
msgid ""
"Start with the record: the subjects, and the description when there is one. If you know the book, pick from what you know.\n"
"\n"
"Otherwise look it up. Google Books lists Categories such as Fiction / Horror, WorldCat lists Genre/Form headings such as Fantasy fiction, and Goodreads shows what readers shelve it as."
msgstr ""
"Kayıtla başlayın: konular ve varsa açıklama. Kitabı biliyorsanız, bildiğinize göre seçin.\n"
"\n"
"Aksi halde araştırın. Google Books Fiction / Horror gibi kategoriler listeler, WorldCat Fantasy fiction gibi tür/biçim başlıkları listeler ve Goodreads okuyucuların onu nasıl sınıflandırdığını gösterir."

#: openlibrary/contribute/field_guides.py
msgid "Goodreads"
msgstr "Goodreads"

#: openlibrary/contribute/field_guides.py
msgid "Go by what the book is sold as, not every element in it. A fantasy with a love story is fantasy; a love story in a fantasy setting is romance."
msgstr "Kitabın neye göre satıldığını esas alın, içindeki her öğeyi değil. Aşk hikâyesi olan bir fantastik kitap yine de fantastiktir; fantastik ortamdaki bir aşk hikâyesi ise romantiktir."

#: openlibrary/contribute/field_guides.py
msgid "Children's and young adult are audiences, not genres, and a subject of just “Fiction” says nothing about genre. With nothing more to go on, choose Not sure."
msgstr "Çocuk ve young adult hedef kitlelerdir, tür değildir, ve yalnızca “Fiction” olan bir konu tür hakkında hiçbir şey söylemez. Dayanacak başka bir şey yoksa, Emin değilim seçeneğini seçin."

#: openlibrary/contribute/field_guides.py
msgid "Pick every genre that fits. Not sure of one? Leave it out."
msgstr "Uygun olan her türü seçin. Birinden emin değil misiniz? Onu dışarıda bırakın."

#: openlibrary/contribute/field_guides.py
msgid "Fill in publisher"
msgstr "Yayıncıyı doldurun"

#: openlibrary/contribute/field_guides.py
msgid "Who published this edition?"
msgstr "Bu baskıyı kim yayınladı?"

#: openlibrary/contribute/field_guides.py
msgid "The imprint is printed on the title page and the spine. The Library of Congress copies it from the title page, and WorldCat lists it under Publisher. Google Books often names the parent company instead."
msgstr "Baskı damgası (imprint) başlık sayfasında ve sırtta basılıdır. Library of Congress bunu başlık sayfasından kopyalar ve WorldCat bunu Yayıncı altında listeler. Google Kitaplar genellikle bunun yerine ana şirketi adlandırır."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the title page. Copy the imprint as it's printed there."
msgstr "%(link_start)sTarama%(link_end)s iç kapağı gösterir. Yayınevi bilgisini (imprint) orada basıldığı şekliyle aynen kopyalayın."

#: openlibrary/contribute/field_guides.py
msgid "Open Library records the imprint printed on the book, not the parent company. Anchor Books, not Penguin Random House."
msgstr "Open Library, ana şirketi değil, kitapta basılı olan imzayı (imprint) kaydeder. Penguin Random House değil, Anchor Books."

#: openlibrary/contribute/field_guides.py
msgid "Publisher as printed"
msgstr "Basılı haliyle yayıncı"

#: openlibrary/contribute/field_guides.py openlibrary/plugins/openlibrary/contribute.py
msgid "Publish date"
msgstr "Yayın tarihi"

#: openlibrary/contribute/field_guides.py
msgid "Fill in publish date"
msgstr "Yayın tarihini doldurun"

#: openlibrary/contribute/field_guides.py
msgid "When was this edition published?"
msgstr "Bu baskı ne zaman yayımlandı?"

#: openlibrary/contribute/field_guides.py
msgid "The copyright page gives the year, often next to the publisher. Google Books lists it as Published, WorldCat as Date, and the Library of Congress record as part of the Published line."
msgstr "Telif hakkı sayfası yılı verir, genellikle yayıneviyle yan yana. Google Books bunu Published olarak, WorldCat Date olarak, ve Library of Congress kaydı Published satırının bir parçası olarak listeler."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page, which gives the year this edition came out."
msgstr "%(link_start)sTarama%(link_end)s telif hakkı sayfasını gösterir; bu da bu baskının çıktığı yılı verir."

#: openlibrary/contribute/field_guides.py
msgid "Enter the year this edition came out, or the full date if a catalog gives one, such as March 2005. A later printing of the same edition keeps the edition's year."
msgstr "Bu baskının çıktığı yılı ya da bir katalog veriyorsa tam tarihi girin, örneğin Mart 2005. Aynı baskının daha sonraki bir baskısı, baskının yılını korur."

#: openlibrary/contribute/field_guides.py
msgid "For example 2005 or March 2005"
msgstr "Örneğin 2005 veya Mart 2005"

#: openlibrary/contribute/field_guides.py
msgid "Fill in ISBN"
msgstr "ISBN'yi doldurun"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's ISBN?"
msgstr "Bu baskının ISBN'si nedir?"

#: openlibrary/contribute/field_guides.py
msgid "The ISBN is printed on the copyright page and on the back cover, above the barcode. Without the book in hand, search WorldCat or Google Books by title and author, open the record whose publisher, year and format match this one, and copy the ISBN it lists."
msgstr "ISBN, telif hakkı sayfasında ve arka kapakta, barkodun üzerinde basılıdır. Kitap elinizde değilse, WorldCat veya Google Books'ta başlık ve yazara göre arama yapın, yayınevi, yıl ve formatı bu baskıyla eşleşen kaydı açın ve listelenen ISBN'yi kopyalayın."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page and the back cover, where the ISBN is printed."
msgstr "%(link_start)sTarama%(link_end)s telif hakkı sayfasını ve arka kapağı gösterir; ISBN orada basılıdır."

#: openlibrary/contribute/field_guides.py
msgid "An ISBN-10 and an ISBN-13 can name the same edition: 0140449264 and 9780140449266. Paste either, with or without hyphens. Books from before 1970 don't have one."
msgstr "Bir ISBN-10 ve bir ISBN-13 aynı baskıyı gösterebilir: 0140449264 ve 9780140449266. Herhangi birini, tire ile veya tiresiz yapıştırın. 1970'ten önceki kitapların ISBN'si yoktur."

#: openlibrary/contribute/field_guides.py
msgid "The ISBN belongs to another format of the book: a hardcover, paperback, ebook and audiobook each have their own."
msgstr "Bu ISBN kitabın başka bir formatına ait: ciltli, karton kapaklı, e-kitap ve sesli kitabın her birinin kendi ISBN'si vardır."

#: openlibrary/contribute/field_guides.py
msgid "For example 9780140449266"
msgstr "Örneğin 9780140449266"

#: openlibrary/contribute/field_guides.py
msgid "I checked that the publisher, year and format match this edition."
msgstr "Yayınevi, yıl ve formatın bu baskıyla eşleştiğini kontrol ettim."

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress number (LCCN)"
msgstr "Library of Congress numarası (LCCN)"

#: openlibrary/contribute/field_guides.py
msgid "Fill in LCCN"
msgstr "LCCN'yi doldurun"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's Library of Congress number?"
msgstr "Bu baskının Library of Congress numarası nedir?"

#: openlibrary/contribute/field_guides.py
msgid "Search the Library of Congress catalog for this ISBN, open the matching record and copy the number shown as LCCN."
msgstr "Bu ISBN'yi Library of Congress kataloğunda arayın, eşleşen kaydı açın ve LCCN olarak gösterilen numarayı kopyalayın."

#: openlibrary/contribute/field_guides.py
#, python-format
msgid "%(link_start)sThe scan%(link_end)s shows the copyright page. Books from the 1970s on often print the LCCN there, in the cataloging data."
msgstr "%(link_start)sTarama%(link_end)s telif hakkı sayfasını gösterir. 1970'lerden itibaren kitaplar genellikle orada, katalog verilerinde LCCN'yi basar."

#: openlibrary/contribute/field_guides.py
msgid "Hyphenated and padded forms are the same number: 75-425165 and 75425165. Paste either; Open Library stores the padded form."
msgstr "Tireli ve dolgulu biçimler aynı numaradır: 75-425165 ve 75425165. Herhangi birini yapıştırın; Open Library dolgulu biçimi saklar."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different edition: another publisher's, a revised edition, a translation or the ebook. Each has its own record."
msgstr "Bu numara farklı bir baskıya ait: başka bir yayıncının baskısı, gözden geçirilmiş bir baskı, bir çeviri veya e-kitap. Her birinin kendi kaydı vardır."

#: openlibrary/contribute/field_guides.py
msgid "For example 75425165"
msgstr "Örneğin 75425165"

#: openlibrary/contribute/field_guides.py
msgid "I opened the record and its publisher and edition match this one."
msgstr "Kaydı açtım ve yayıncısı ile baskısı bununla eşleşiyor."

#: openlibrary/contribute/field_guides.py
msgid "OCLC/WorldCat number"
msgstr "OCLC/WorldCat numarası"

#: openlibrary/contribute/field_guides.py
msgid "Fill in OCLC number"
msgstr "OCLC numarasını doldurun"

#: openlibrary/contribute/field_guides.py
msgid "What is this edition's WorldCat (OCLC) number?"
msgstr "Bu baskının WorldCat (OCLC) numarası nedir?"

#: openlibrary/contribute/field_guides.py
msgid "Search WorldCat for this ISBN, open the matching print record and copy the number shown as OCLC Number."
msgstr "Bu ISBN'yi WorldCat'te arayın, eşleşen basılı kaydı açın ve OCLC Number olarak gösterilen numarayı kopyalayın."

#: openlibrary/contribute/field_guides.py
msgid "The prefixes ocm, ocn, on and (OCoLC) are padding added by library systems, not part of the number. ocm00047810608 is 47810608."
msgstr "ocm, ocn, on ve (OCoLC) önekleri, kütüphane sistemleri tarafından eklenen dolgulardır, numaranın bir parçası değildir. ocm00047810608, 47810608'dir."

#: openlibrary/contribute/field_guides.py
msgid "WorldCat sometimes lists one edition more than once. Any of those numbers is right; OCLC merges them over time."
msgstr "WorldCat bazen bir baskıyı birden fazla kez listeler. Bu numaralardan herhangi biri doğrudur; OCLC zamanla bunları birleştirir."

#: openlibrary/contribute/field_guides.py
msgid "The number belongs to a different record: the ebook, another publisher's edition, a revised edition, large print or a translation."
msgstr "Bu numara farklı bir kayda ait: e-kitap, başka bir yayıncının baskısı, gözden geçirilmiş bir baskı, büyük punto baskı veya çeviri."

#: openlibrary/contribute/field_guides.py
msgid "Pasting the web address, or leaving the ocm/ocn prefix on."
msgstr "Web adresini yapıştırmak veya ocm/ocn önekini bırakmak."

#: openlibrary/contribute/field_guides.py
msgid "Digits only, for example 47810608"
msgstr "Yalnızca rakamlar, örneğin 47810608"

#: openlibrary/contribute/field_guides.py
msgid "I opened a print record and its publisher and edition match this one."
msgstr "Basılı bir kayıt açtım ve yayıncısı ile baskısı bununla eşleşiyor."

#: openlibrary/contribute/field_guides.py
msgid "This edition has a Library of Congress record, which gives the language and the publisher as printed."
msgstr "Bu baskının Library of Congress'te, dili ve yayınevini basılı haliyle veren bir kaydı var."

#: openlibrary/contribute/field_guides.py
msgid "Library of Congress record"
msgstr "Library of Congress kaydı"

#: openlibrary/contribute/field_guides.py
msgid "ISFDB covers science fiction and fantasy printing by printing."
msgstr "ISFDB, bilim kurgu ve fantazi türünü baskı baskı kapsar."

