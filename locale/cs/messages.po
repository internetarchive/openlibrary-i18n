#: openlibrary/core/tags.py
msgid "Novels, stories, plays and poems."
msgstr "Romány, povídky, divadelní hry a básně."

#: openlibrary/core/tags.py
msgid "History, biography, memoir, essays, how-to and reference."
msgstr "Historie, životopisy, memoáry, eseje, návody a referenční literatura."

#: openlibrary/core/tags.py
msgid "Hard to call, like a book based on a true story or a collection that mixes fiction and nonfiction."
msgstr "Těžko rozhodnout, například u knihy založené na skutečném příběhu nebo sbírky, která mísí beletrii a literaturu faktu."

#: openlibrary/edition_scorecard.py
msgid "Can be accessed in full online (read / borrowed)"
msgstr "Lze přistupovat celé online (čtení / výpůjčka)"

#: openlibrary/edition_scorecard.py
msgid "Borrowable and readable books can be accessed by readers, researchers, and all patrons alike."
msgstr "Ke knihám, které lze půjčit a číst, mají přístup čtenáři, badatelé i všichni ostatní uživatelé."

#: openlibrary/edition_scorecard.py
msgid "Can view snippets via search inside"
msgstr "Lze zobrazit úryvky pomocí vyhledávání uvnitř knihy"

#: openlibrary/edition_scorecard.py
msgid "Books that allow search inside enable patrons to quickly find relevant content within the book."
msgstr "Knihy, které umožňují vyhledávání uvnitř, umožňují uživatelům rychle najít relevantní obsah v knize."

#: openlibrary/edition_scorecard.py
msgid "Open access (can analyze in full)"
msgstr "Otevřený přístup (lze plně analyzovat)"

#: openlibrary/edition_scorecard.py
msgid "Fully public books can be read online or downloaded without any restrictions, providing excellent access for patrons."
msgstr "Zcela veřejné knihy lze číst online nebo stáhnout bez jakýchkoli omezení, což poskytuje uživatelům vynikající přístup."

#: openlibrary/edition_scorecard.py
msgid "Has purchase options"
msgstr "Má možnosti nákupu"

#: openlibrary/edition_scorecard.py
msgid "An ISBN, Amazon ASIN identifier, or BWB identifier enables patrons to purchase the book from retailers."
msgstr "ISBN, identifikátor Amazon ASIN nebo identifikátor BWB umožňuje uživatelům zakoupit knihu u prodejců."

#: openlibrary/edition_scorecard.py
msgid "Has library options (ISBN or OCLC)"
msgstr "Má knihovní možnosti (ISBN nebo OCLC)"

#: openlibrary/edition_scorecard.py
msgid "ISBN or OCLC numbers enable patrons to find the book through library catalogs."
msgstr "Čísla ISBN nebo OCLC umožňují uživatelům najít knihu v knihovních katalozích."

#: openlibrary/edition_scorecard.py
msgid "Has fan fiction link (Archive of Our Own)"
msgstr "Má odkaz na fanfikci (Archive of Our Own)"

#: openlibrary/edition_scorecard.py
msgid "A link to Archive of Our Own helps readers discover related fan-created works."
msgstr "Odkaz na Archive of Our Own pomáhá čtenářům objevit související díla vytvořená fanoušky."

#: openlibrary/edition_scorecard.py
msgid "Has Wikipedia link"
msgstr "Má odkaz na Wikipedii"

#: openlibrary/edition_scorecard.py
msgid "A Wikipedia link provides additional context and encyclopedic information about the work."
msgstr "Odkaz na Wikipedii poskytuje další kontext a encyklopedické informace o díle."

#: openlibrary/edition_scorecard.py
msgid "Has first sentence"
msgstr "Má první větu"

#: openlibrary/edition_scorecard.py
msgid "The first sentence gives patrons an immediate taste of the writing style."
msgstr "První věta poskytuje uživatelům okamžitou ukázku stylu psaní."

#: openlibrary/edition_scorecard.py
msgid "Has title field"
msgstr "Má pole s názvem"

#: openlibrary/edition_scorecard.py
msgid "A title is essential for discovery and helps patrons identify the book in search results and catalogs."
msgstr "Název je nezbytný pro objevování a pomáhá uživatelům identifikovat knihu ve výsledcích vyhledávání a katalozích."

#: openlibrary/edition_scorecard.py
msgid "Has author information"
msgstr "Má informace o autorovi"

#: openlibrary/edition_scorecard.py
msgid "Author information is crucial for discovery and helps patrons find other works by the same author."
msgstr "Informace o autorovi jsou klíčové pro objevování a pomáhají uživatelům najít další díla stejného autora."

#: openlibrary/edition_scorecard.py
msgid "Has genre/category tags"
msgstr "Má štítky žánru/kategorie"

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons search by genre or category to discover relevant books."
msgstr "Štítky žánru pomáhají uživatelům vyhledávat podle žánru nebo kategorie a objevovat relevantní knihy."

#: openlibrary/edition_scorecard.py
msgid "Has series information"
msgstr "Má informace o sérii"

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons search by series and discover related books."
msgstr "Informace o sérii pomáhají uživatelům vyhledávat podle série a objevovat související knihy."

#: openlibrary/edition_scorecard.py
msgid "Has table of contents"
msgstr "Má obsah"

#: openlibrary/edition_scorecard.py
msgid "Table of contents entries are indexed and searchable, improving discoverability."
msgstr "Položky obsahu jsou indexovány a prohledávatelné, což zlepšuje dohledatelnost."

#: openlibrary/edition_scorecard.py
msgid "Has DDC or LCC classification"
msgstr "Má klasifikaci DDC nebo LCC"

#: openlibrary/edition_scorecard.py
msgid "Dewey Decimal or Library of Congress classifications help with organization and shelf browsing."
msgstr "Deweyho desetinné třídění nebo klasifikace Kongresové knihovny pomáhají s organizací a procházením regálů."

#: openlibrary/edition_scorecard.py
msgid "Has language information"
msgstr "Má informace o jazyce"

#: openlibrary/edition_scorecard.py
msgid "Language information helps patrons filter and find books in their preferred language."
msgstr "Informace o jazyce pomáhají uživatelům filtrovat a nacházet knihy v jejich preferovaném jazyce."

#: openlibrary/edition_scorecard.py
msgid "Has ISBN"
msgstr "Má ISBN"

#: openlibrary/edition_scorecard.py
msgid "ISBNs allow searching by barcode scanner and help with identification."
msgstr "ISBN umožňují vyhledávání pomocí čtečky čárových kódů a pomáhají s identifikací."

#: openlibrary/edition_scorecard.py
msgid "Has Lexile measure"
msgstr "Má míru Lexile"

#: openlibrary/edition_scorecard.py
msgid "Lexile measures help educators and parents find books at the appropriate reading level."
msgstr "Míry Lexile pomáhají pedagogům a rodičům najít knihy na odpovídající úrovni čtení."

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (ranking signal)"
msgstr "Má hodnocení hvězdičkami (signál pro řazení)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings contribute to search ranking so better-rated books surface higher."
msgstr "Hodnocení hvězdičkami přispívá k řazení ve vyhledávání, takže lépe hodnocené knihy se zobrazují výše."

#: openlibrary/edition_scorecard.py
msgid "Appears on reading logs (ranking signal)"
msgstr "Objevuje se ve čtenářských denících (signál pro řazení)"

#: openlibrary/edition_scorecard.py
msgid "Presence on reading logs is a popularity signal that helps with search ranking."
msgstr "Přítomnost ve čtenářských denících je signálem popularity, který pomáhá s řazením ve vyhledávání."

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (ranking signal)"
msgstr "Objevuje se v seznamech (signál pro řazení)"

#: openlibrary/edition_scorecard.py
msgid "Presence on user lists is a popularity signal that helps with search ranking."
msgstr "Přítomnost v uživatelských seznamech je signálem popularity, který pomáhá s řazením ve vyhledávání."

#: openlibrary/edition_scorecard.py
msgid "Has contributor names"
msgstr "Má jména přispěvatelů"

#: openlibrary/edition_scorecard.py
msgid "Contributor names (editors, illustrators, translators) enable searching by contributor."
msgstr "Jména přispěvatelů (editorů, ilustrátorů, překladatelů) umožňují vyhledávání podle přispěvatele."

#: openlibrary/edition_scorecard.py
msgid "Has a description"
msgstr "Má popis"

#: openlibrary/edition_scorecard.py
msgid "A description helps patrons understand what the book is about before accessing it."
msgstr "Popis pomáhá uživatelům pochopit, o čem kniha je, ještě než k ní přistoupí."

#: openlibrary/edition_scorecard.py
msgid "Has cover image"
msgstr "Má obrázek obálky"

#: openlibrary/edition_scorecard.py
msgid "A cover image helps patrons visually identify the book and makes it more appealing in search results."
msgstr "Obrázek obálky pomáhá uživatelům knihu vizuálně identifikovat a činí ji přitažlivější ve výsledcích vyhledávání."

#: openlibrary/edition_scorecard.py
msgid "A table of contents helps patrons evaluate the structure and scope of the book."
msgstr "Obsah pomáhá uživatelům posoudit strukturu a rozsah knihy."

#: openlibrary/edition_scorecard.py
msgid "Genre tags help patrons quickly assess whether a book matches their interests."
msgstr "Štítky žánru pomáhají uživatelům rychle posoudit, zda kniha odpovídá jejich zájmům."

#: openlibrary/edition_scorecard.py
msgid "Has star ratings (popularity signal)"
msgstr "Má hodnocení hvězdičkami (signál popularity)"

#: openlibrary/edition_scorecard.py
msgid "Star ratings from other readers help patrons gauge the quality and reception of the book."
msgstr "Hodnocení hvězdičkami od ostatních čtenářů pomáhají uživatelům posoudit kvalitu a přijetí knihy."

#: openlibrary/edition_scorecard.py
msgid "Has a rich description (50+ characters)"
msgstr "Má bohatý popis (50+ znaků)"

#: openlibrary/edition_scorecard.py
msgid "A detailed description (50+ characters) provides more context to help patrons evaluate relevance."
msgstr "Podrobný popis (50+ znaků) poskytuje více kontextu, který pomáhá uživatelům posoudit relevanci."

#: openlibrary/edition_scorecard.py
msgid "Has reading log activity (popularity signal)"
msgstr "Má aktivitu ve čtenářském deníku (signál popularity)"

#: openlibrary/edition_scorecard.py
msgid "Reading log activity from other patrons signals the book is being actively read."
msgstr "Aktivita ve čtenářském deníku od ostatních uživatelů signalizuje, že je kniha aktivně čtena."

#: openlibrary/edition_scorecard.py
msgid "Appears on lists (popularity signal)"
msgstr "Objevuje se v seznamech (signál popularity)"

#: openlibrary/edition_scorecard.py
msgid "Presence on curated lists helps patrons gauge relevance and community interest."
msgstr "Přítomnost ve spravovaných seznamech pomáhá uživatelům posoudit relevanci a zájem komunity."

#: openlibrary/edition_scorecard.py
msgid "Has page count"
msgstr "Má počet stran"

#: openlibrary/edition_scorecard.py
msgid "Page count helps patrons estimate the length and time commitment of the book."
msgstr "Počet stran pomáhá uživatelům odhadnout délku a časovou náročnost knihy."

#: openlibrary/edition_scorecard.py
msgid "Series information helps patrons understand the book's place in a broader narrative."
msgstr "Informace o sérii pomáhají uživatelům pochopit místo knihy v širším příběhu."

#: openlibrary/edition_scorecard.py
msgid "Has author photo"
msgstr "Má fotografii autora"

#: openlibrary/edition_scorecard.py
msgid "An author photo helps patrons visually recognize the author."
msgstr "Fotografie autora pomáhá uživatelům vizuálně rozpoznat autora."

#: openlibrary/edition_scorecard.py
msgid "Has first publication year"
msgstr "Má rok prvního vydání"

#: openlibrary/edition_scorecard.py
msgid "The first publication year helps patrons understand when the work originally appeared."
msgstr "Rok prvního vydání pomáhá uživatelům pochopit, kdy dílo poprvé vyšlo."

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
#, fuzzy
msgid "Has publication year"
msgstr "Rok vydání"

#: openlibrary/edition_scorecard.py
msgid "Publication year helps patrons understand the context and currency of the content."
msgstr "Rok vydání pomáhá uživatelům pochopit kontext a aktuálnost obsahu."

#: openlibrary/edition_scorecard.py
msgid "Has author biography"
msgstr "Má biografii autora"

#: openlibrary/edition_scorecard.py
msgid "An author biography helps patrons understand the author's background and expertise."
msgstr "Biografie autora pomáhá uživatelům pochopit autorovo zázemí a odbornost."

#: openlibrary/edition_scorecard.py openlibrary/plugins/openlibrary/librarian_dashboard.py
#, fuzzy
msgid "Has publisher"
msgstr "Vydavatel"

#: openlibrary/edition_scorecard.py
msgid "Publisher information helps patrons evaluate the credibility and source of the book."
msgstr "Informace o vydavateli pomáhají uživatelům posoudit důvěryhodnost a zdroj knihy."

#: openlibrary/edition_scorecard.py
msgid "Has author links"
msgstr "Má odkazy na autora"

#: openlibrary/edition_scorecard.py
msgid "Links to author websites or profiles provide additional context about the author."
msgstr "Odkazy na webové stránky nebo profily autora poskytují další kontext o autorovi."

#: openlibrary/edition_scorecard.py
msgid "Edition Scorecard"
msgstr "Karta hodnocení vydání"

#: openlibrary/edition_scorecard.py
msgid "Discovery"
msgstr "Objevování"

#: openlibrary/edition_scorecard.py
msgid "How well can this edition be accurately surfaced in searches and recommendations?"
msgstr "Jak dobře lze toto vydání přesně zobrazit ve vyhledávání a doporučeních?"

#: openlibrary/edition_scorecard.py
msgid "Evaluation"
msgstr "Hodnocení"

#: openlibrary/edition_scorecard.py
msgid "How well can a patron determine if this edition is relevant to their needs before accessing it?"
msgstr "Jak dobře dokáže uživatel posoudit, zda je toto vydání relevantní pro jeho potřeby, ještě než k němu přistoupí?"

